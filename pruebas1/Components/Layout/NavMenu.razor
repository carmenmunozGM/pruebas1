            <img class="navbar-brand" src="/images/logomail.png" style="width: 250px; border-radius:15px; height: auto;" alt="Logotipo" />

            <div class="d-flex align-items-center">
                <div class="navbar-nav ms-auto">
                    <button class="subnav-btn" @onclick="@dias">
                        Día
                    </button>
                    <button class="subnav-btn" @onclick="@semanas">
                        Semana
                    </button>
                    <button class="subnav-btn" @onclick="@mes">
                        Mes
                    </button>
                    <button class="subnav-btn" @onclick="@plan">
                        Servicio al cliente
                    </button>
                    <button class="subnav-btn" @onclick="@autoevaluacion">
                        Autoevaluación
                    </button>
                </div>
            </div>

            <div class="dropdown">
                <a class="nav-link user-nav dropdown-toggle"
                   href="#" id="userDropdown"
                   role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    👤
                    @nombreCompleto (@clavePersonal)
                </a>
                <ul class="dropdown-menu dropdown-menu-end rounded-xl overflow-hidden shadow-lg border border-gray-200" aria-labelledby="userDropdown">
                    <li>
                        <a class="dropdown-item custom-menu-item" style="cursor:pointer" @onclick="configur">
                            <span class="menu-icon">⚙️</span>
                            <span>Configuración</span>
                        </a>
                    </li>

                    <li><hr class="dropdown-divider"></li>

                    <li>
                        <a class="dropdown-item custom-menu-item" style="cursor:pointer" @onclick="IrArchivoInstitucional">
                            <span class="menu-icon">🏛️</span>
                            <span>Archivo Institucional</span>
                        </a>
                    </li>
                    
                    @if (MostrarArchivoPermanente)
                    {
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item custom-menu-item" style="cursor:pointer" @onclick="IrArchivoPermanente">
                                <span class="menu-icon">📂</span>
                                <span>Archivo Permanente</span>
                            </a>
                        </li>
                    }

                    <li><hr class="dropdown-divider"></li>

                    <li>
                        <a class="dropdown-item custom-menu-item" style="cursor:pointer" @onclick="cerrarsesion">
                            <span class="menu-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                    <polyline points="16 17 21 12 16 7"></polyline>
                                    <line x1="21" y1="12" x2="9" y2="12"></line>
                                </svg>
                            </span>
                            <span>Cerrar sesión</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</div>

