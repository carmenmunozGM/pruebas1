@using pruebas1.Components.DTOs
@using pruebas1.Components.Layout
@using pruebas1.Servicios
@layout LoginLayout
@page "/"
@inject LoginService loginService
@inject NavigationManager navigate
@inject UsuarioService UsuarioService   
@inject AgendaService AgendaService
@inject UsuarioState UsuarioState
@inject HorariosService HorariosService

<EditForm Model="@loginDTO" OnValidSubmit="Ingresar" class="login-container">
    <DataAnnotationsValidator />

    <div class="login-card">
        <!-- Encabezado -->
        <div class="login-header">
            <h2>Bienvenido a <span>Grupo Méndez</span></h2>
            <h3>Agenda GM</h3>
        </div>
                @if (entrandoPorSso)
        {
            <!-- Entrando desde la Red GM: sin campos ni botón, para que nadie interrumpa -->
            <div class="sso-cargando">
                <span class="spinner-border" aria-hidden="true"></span>
                <p>Ingresando desde la Red GM...</p>
            </div>
        }
        else
        {
        <!-- Usuario -->
        <div class="form-group">
            <label>Usuario</label>
            <InputText class="form-control custom-input" @bind-Value="@loginDTO.nombreusuario" />
            <ValidationMessage For="(() => loginDTO.nombreusuario)" />
        </div>

        <!-- Contraseña -->
        <div class="form-group">
            <label>Contraseña</label>
            <InputText type="password" class="form-control custom-input" @bind-Value="@loginDTO.contraseña" />
            <ValidationMessage For="(() => loginDTO.contraseña)" />
        </div>
        <br />

        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="alert alert-danger" role="alert">
                @mensajeError
            </div>
        }


        @if (Loading)
        {
            <!-- Botón -->
            <div class="form-actions mt-3">
                <button class="btn-login" type="button" disabled>
                    <span class="spinner-grow spinner-grow-sm" aria-hidden="true"></span>
                    <span role="status">Ingresando...</span>
                </button>
            </div>
        }
        else
        {
            <!-- Botón -->
            <div class="form-actions mt-3">
                <button type="submit" class="btn-login">Ingresar</button>
            </div>
        }
        }

    </div>
</EditForm>

<style>

    /* Fondo general */
    .login-container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        background: linear-gradient(135deg, #0B5A67, #263C63);
        padding: 1rem;
    }

    /* Tarjeta */
    .login-card {
        background: #FFFFFF;
        padding: 2rem;
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.2);
        width: 100%;
        max-width: 400px;
        text-align: center;
    }

    .sso-cargando {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        padding: 2rem 0;
        color: #263C63;
        font-size: 1.1rem;
    }

    /* Encabezado */
    .login-header h2 {
        color: #0B5A67;
        font-size: 1.6rem;
        margin-bottom: 0.3rem;
    }

        .login-header h2 span {
            color: #263C63;
            font-weight: bold;
        }

    .login-header h3 {
        color: #263C63;
        font-size: 1.3rem;
        margin-bottom: 2rem;
        font-weight: normal;
    }

    /* Inputs */
    .custom-input {
        border: 1px solid #ccc;
        border-radius: 12px;
        padding: 0.75rem;
        width: 100%;
        margin-top: 0.3rem;
        font-size: 1rem;
    }

        .custom-input:focus {
            border-color: #0B5A67;
            outline: none;
            box-shadow: 0 0 4px rgba(11, 90, 103, 0.4);
        }

    /* Botón */
    .btn-login {
        width: 100%;
        padding: 0.9rem;
        border-radius: 12px;
        border: none;
        background-color: #0B5A67;
        color: #FFFFFF;
        font-size: 1.1rem;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .btn-login:hover {
            background-color: #263C63;
        }

</style>

@code {
    public LoginDTO loginDTO { get; set; } = new LoginDTO();
    private bool Loading { get; set; } = false;
    private string mensajeError = string.Empty;

    HoraSistemaDTO? alertaHora;
    bool mostrarAlerta = false;

    // Token que mandó la Red GM (pruebas1.exe --sso <token>). Solo se usa una vez.
    private string? tokenSso;

    // Mientras sea true, en lugar del formulario se muestra "Ingresando desde la Red GM"
    private bool entrandoPorSso;

    protected override void OnInitialized()
    {
        // Se lee antes de dibujar la pantalla, para que el formulario ni siquiera aparezca
        tokenSso = SsoArgs.Tomar();
        entrandoPorSso = !string.IsNullOrEmpty(tokenSso);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !entrandoPorSso) return;

        bool entro = await EntrarAsync(() => loginService.loginSso(tokenSso!));

        if (!entro)
        {
            // Algo falló (token vencido, sin conexión, hora desfasada): se muestra el login normal
            entrandoPorSso = false;
            StateHasChanged();
        }
    }

    private async Task<bool> ValidarHora()
    {
        var resultado = await HorariosService.GetHorario();

        if (resultado.Desfase)
        {
            alertaHora = resultado;
            mostrarAlerta = true;

            await InvokeAsync(StateHasChanged);

            return false;
        }

        return true;
    }

    // Botón "Ingresar": para el usuario no cambia nada
    private Task Ingresar() => EntrarAsync(() => loginService.login(loginDTO));

    // Antes era el contenido de Ingresar(); ahora lo comparten el login normal y el SSO
    private async Task<bool> EntrarAsync(Func<Task<UsuarioLoginDTO>> autenticar)
    {
        if (!await ValidarHora()) return false;


        Loading = true;
        mensajeError = string.Empty;
        StateHasChanged();   // muestra el "cargando" también cuando entra por SSO

        try
        {
            // Login (normal o SSO)
            var usuario = await autenticar();

            // Obtener agendas asignadas
            usuario.IdAgendasAsignadas = await AgendaService.ObtenerAgendaAsignadasAsync();

            // Guardar usuario
            loginService.guardarUsuario(usuario);

            // UsuarioState
            int agendaActual = usuario.IdAgendasAsignadas?.FirstOrDefault() ?? 0;
            UsuarioState.SetUsuario(usuario.IdUsuario, agendaActual);

            Console.WriteLine($"[Login] IdUsuario: {usuario.IdUsuario}, IdAgenda: {agendaActual}");

            await AgendaService.ObtenerTareasApi(agendaActual);
            await AgendaService.ObtenerEventos(agendaActual);

            navigate.NavigateTo("/dia2");
            return true;
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
            return false;
        }
        finally
        {
            Loading = false;
        }
    }
}
<ReusableHorarioAlert @key="mostrarAlerta"
                      HoraSistema="alertaHora"
                      Visible="mostrarAlerta" />
