@using pruebas1.Components.DTOs
@using pruebas1.Servicios
@inject IJSRuntime JS
@inject ArchivoPermanenteService ArchivoService

@if (Visible)
{
    <div class="modal-crear-overlay">
        <div class="modal-crear">
            <div class="modal-crear-header">
                <h3>📁 Nueva carpeta</h3>
                <button class="btn-cerrar-crear" @onclick="Cerrar">✕</button>
            </div>

            <div class="modal-crear-body">
                @if (Cargando)
                {
                    <div class="loading-crear">
                        Cargando estructura...
                    </div>
                }
                else
                {
                    <h4>Ruta destino</h4>

                    @* 🔥 NUEVO: Capa invisible para atrapar los clics fuera del menú *@
                    @if (MenuAbierto.Any(m => m))
                    {
                        <div class="dropdown-overlay-cerrar" @onclick="CerrarTodosLosMenus"></div>
                    }

                    @for (int i = 0; i < Niveles.Count; i++)
                    {
                        int indice = i;

                        <div class="custom-select-wrapper">
                            <div class="combo-ruta-crear custom-select-header" @onclick="() => AlternarMenu(indice)">
                                <span>@(ObtenerNombreSeleccionado(indice) ?? "Seleccione...")</span>
                                <span style="font-size: 12px; color: #666;">▼</span>
                            </div>

                            @if (MenuAbierto.Count > indice && MenuAbierto[indice])
                            {
                                <ul class="custom-select-list">
                                    @if (indice == 0)
                                    {
                                        <li class="custom-select-item @(CarpetaSeleccionada?.IdSharePoint == "root" ? "seleccionado" : "")"
                                            @onclick="@(() => SeleccionarOpcion(indice, "root"))">
                                            📁 Carpeta Raíz (Principal)
                                        </li>
                                    }
                                    else
                                    {
                                        <li class="custom-select-item" @onclick="@(() => SeleccionarOpcion(indice, ""))">
                                            Seleccione...
                                        </li>
                                    }

                                    @foreach (var item in Niveles[i])
                                    {
                                        <li class="custom-select-item @(Seleccionados.Count > indice && Seleccionados[indice]?.Id == item.Id ? "seleccionado" : "")"
                                            @onclick="@(() => SeleccionarOpcion(indice, item.Id.ToString()))">
                                            @($"{item.Codigo} - {item.Nombre}")
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    }

                    <div class="campo-crear">
                        <label>Nombre de la carpeta</label>
                        <input class="input-crear"
                               type="text"
                               @bind="NombreCarpeta"
                               @bind:event="oninput"
                               placeholder="Ej. Documentos 2026" />
                    </div>

                    @if (GuardadoCorrectamente)
                    {
                        <div class="mensaje-ok-crear">
                            ✔ Carpeta creada correctamente
                        </div>
                    }
                }
            </div>

            <div class="modal-crear-footer">
                <button class="btn-cancelar-crear" @onclick="Cerrar">
                    Cancelar
                </button>

                <button class="btn-guardar-crear"
                        disabled="@(!PuedeGuardar || Guardando)"
                        @onclick="GuardarCarpeta">
                    @if (Guardando)
                    {
                        <span class="spinner-crear"></span>
                        <span>Creando...</span>
                    }
                    else
                    {
                        <span>📁 Crear</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnCarpetaCreada { get; set; }

    private bool Cargando;
    private bool Guardando;
    private bool GuardadoCorrectamente;
    private List<UbicacionDTO> Ubicaciones = new();
    private List<List<UbicacionDTO>> Niveles = new();
    private List<UbicacionDTO?> Seleccionados = new();
    private List<bool> MenuAbierto = new(); // 🟢 Controla qué menús están abiertos

    private UbicacionDTO? CarpetaSeleccionada;
    private string NombreCarpeta = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (!Visible)
            return;

        if (Ubicaciones.Any())
            return;

        Cargando = true;

        Ubicaciones = await ArchivoService.ObtenerUbicaciones();

        Niveles.Clear();
        Seleccionados.Clear();
        MenuAbierto.Clear();

        Niveles.Add(Ubicaciones);
        MenuAbierto.Add(false); // Inicializa el menú del nivel 0 como cerrado

        // AQUÍ ESTABLECEMOS LA RAÍZ POR DEFECTO AL ABRIR
        CarpetaSeleccionada = new UbicacionDTO
        {
            IdSharePoint = "root"
        };

        Cargando = false;
    }

    // 🟢 Nuevo método para abrir/cerrar el menú desplegable personalizado
    private void AlternarMenu(int nivel)
    {
        bool estadoActual = MenuAbierto[nivel];

        // Cierra todos los menús
        for (int i = 0; i < MenuAbierto.Count; i++)
        {
            MenuAbierto[i] = false;
        }

        // Abre el que se clickeó (si estaba cerrado)
        MenuAbierto[nivel] = !estadoActual;
    }

    // 🟢 Nuevo método para cuando se hace clic en un <li>
    private void SeleccionarOpcion(int nivel, string valor)
    {
        MenuAbierto[nivel] = false; // Cierra el menú
        SeleccionarNivel(nivel, valor); // Ejecuta tu lógica original
    }

    // 🟢 Nuevo método para mostrar el texto correcto en el cuadro simulado
    private string ObtenerNombreSeleccionado(int nivel)
    {
        if (nivel == 0)
        {
            if (Seleccionados.Count > 0 && Seleccionados[0] != null)
                return $"{Seleccionados[0].Codigo} - {Seleccionados[0].Nombre}";

            return "📁 Carpeta Raíz (Principal)";
        }

        if (Seleccionados.Count > nivel && Seleccionados[nivel] != null)
            return $"{Seleccionados[nivel].Codigo} - {Seleccionados[nivel].Nombre}";

        return null;
    }

    private void SeleccionarNivel(int nivel, string? valor)
    {
        while (Niveles.Count > nivel + 1)
            Niveles.RemoveAt(nivel + 1);

        while (Seleccionados.Count > nivel)
            Seleccionados.RemoveAt(nivel);

        while (MenuAbierto.Count > nivel + 1)
            MenuAbierto.RemoveAt(nivel + 1); // 🟢 Sincronizamos el estado visual de los menús

        // Si el usuario selecciona la opción raíz explícitamente en el primer nivel
        if (nivel == 0 && valor == "root")
        {
            CarpetaSeleccionada = new UbicacionDTO { IdSharePoint = "root" };
            return;
        }

        if (string.IsNullOrWhiteSpace(valor))
        {
            // Si des selecciona en niveles inferiores, regresa el apuntador al padre anterior o a la raíz
            CarpetaSeleccionada = nivel == 0 ? new UbicacionDTO { IdSharePoint = "root" } : Seleccionados.LastOrDefault();
            return;
        }

        var seleccionado = Niveles[nivel].First(x => x.Id == int.Parse(valor));

        Seleccionados.Add(seleccionado);
        CarpetaSeleccionada = seleccionado;

        if (seleccionado.Hijos.Any())
        {
            Niveles.Add(seleccionado.Hijos);
            MenuAbierto.Add(false); // 🟢 Agregamos estado para el nuevo nivel
        }
    }

    private bool PuedeGuardar
    {
        get
        {
            if (CarpetaSeleccionada == null || string.IsNullOrWhiteSpace(CarpetaSeleccionada.IdSharePoint))
                return false;

            return !string.IsNullOrWhiteSpace(NombreCarpeta);
        }
    }

    private async Task GuardarCarpeta()
    {
        if (CarpetaSeleccionada == null || string.IsNullOrWhiteSpace(NombreCarpeta))
            return;

        try
        {
            Guardando = true;

            string? idPadreEnviar = CarpetaSeleccionada.IdSharePoint == "root"
                                    ? null
                                    : CarpetaSeleccionada.IdSharePoint;

            var dto = new CrearCarpetaDTO
            {
                Nombre = NombreCarpeta,
                IdCarpetaPadre = idPadreEnviar
            };

            bool exito = await ArchivoService.CrearCarpeta(dto);

            if (exito)
            {
                GuardadoCorrectamente = true;
                StateHasChanged();

                await Task.Delay(900);
                await Limpiar();
                await OnCarpetaCreada.InvokeAsync();
                await Cerrar();
            }
        }
        catch (Exception ex)
        {
            // 🔥 AQUÍ REEMPLAZAMOS EL ALERT FEO POR SWEETALERT 🔥
            await JS.InvokeVoidAsync("Swal.fire", new
            {
                title = "No se pudo crear",
                text = $"No fue posible crear la carpeta.\n\n{ex.Message}",
                icon = "error",
                confirmButtonText = "Entendido",
                confirmButtonColor = "#2d7ff9" // Este es el azul que usas en tu botón de "Crear"
            });
        }
        finally
        {
            Guardando = false;
        }
    }

    private async Task Cerrar()
    {
        await Limpiar();
        await OnClose.InvokeAsync();
    }

    private Task Limpiar()
    {
        NombreCarpeta = string.Empty;
        GuardadoCorrectamente = false;
        Niveles.Clear();
        Seleccionados.Clear();
        MenuAbierto.Clear();

        Niveles.Add(Ubicaciones);
        MenuAbierto.Add(false);

        CarpetaSeleccionada = new UbicacionDTO { IdSharePoint = "root" };

        return Task.CompletedTask;
    }

    // 🟢 Nuevo método para cerrar los menús al hacer clic fuera
    private void CerrarTodosLosMenus()
    {
        for (int i = 0; i < MenuAbierto.Count; i++)
        {
            MenuAbierto[i] = false;
        }
    }
}