@using pruebas1.Components.DTOs
@using pruebas1.Servicios
@inject IJSRuntime JS
@inject ArchivoPermanenteService ArchivoService

@if (Visible)
{
    <div class="modal-crear-overlay">
        <div class="modal-crear">
            <div class="modal-crear-header">
                <h3>📁 Nueva carpeta</h3>
                <button class="btn-cerrar-crear" @onclick="Cerrar">✕</button>
            </div>

            <div class="modal-crear-body">
                @if (Cargando)
                {
                    <div class="loading-crear">
                        Cargando estructura...
                    </div>
                }
                else
                {
                    <h4>Ruta destino</h4>

                    @for (int i = 0; i < Niveles.Count; i++)
                    {
                        int indice = i;
                        bool esRaiz = (indice == 0);
                        bool estaAbierto = DropdownAbiertoIndice == indice;
                        string textoSeleccionado = ObtenerTextoSeleccionado(indice);
                        var listaOpciones = ObtenerOpcionesFiltradas(indice);

                        <div class="custom-select-container">
                            <div class="custom-select-trigger" @onclick="() => ToggleDropdown(indice)">
                                <span>@textoSeleccionado</span>
                                <span class="arrow">▼</span>
                            </div>

                            @if (estaAbierto)
                            {
                                <div class="custom-select-menu">
                                    <div class="search-box-inside">
                                        <input type="text"
                                               class="input-search-dropdown"
                                               placeholder="🔍 Buscar..."
                                               @bind="TextoBusqueda"
                                               @bind:event="oninput"
                                               @onclick:stopPropagation />
                                    </div>
                                    <ul class="custom-select-options">
                                        @if (esRaiz)
                                        {
                                            <li class="@(Seleccionados.Count == 0 ? "selected" : "")"
                                                @onclick='() => SeleccionarOpcion(indice, "root", "📁 Carpeta Raíz (Principal)")'>
                                                📁 Carpeta Raíz (Principal)
                                            </li>
                                        }
                                        else
                                        {
                                            <li class="@(Seleccionados.Count <= indice ? "selected" : "")"
                                                @onclick='() => SeleccionarOpcion(indice, "", "Seleccione...")'>
                                                Seleccione...
                                            </li>
                                        }

                                        @foreach (var item in listaOpciones)
                                        {
                                            bool esSeleccionado = Seleccionados.Count > indice && Seleccionados[indice]?.IdSharePoint == item.IdSharePoint;
                                            <li class="@(esSeleccionado ? "selected" : "")"
                                                @onclick='() => SeleccionarOpcion(indice, item.IdSharePoint, item.Nombre)'>
                                                @item.Nombre
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    }

                    <div class="campo-crear">
                        <label>Nombre de la carpeta</label>
                        <input class="input-crear"
                               type="text"
                               @bind="NombreCarpeta"
                               @bind:event="oninput"
                               placeholder="Ej. Documentos 2026" />
                    </div>

                    @if (GuardadoCorrectamente)
                    {
                        <div class="mensaje-ok-crear">
                            ✔ Carpeta creada correctamente
                        </div>
                    }
                }
            </div>

            <div class="modal-crear-footer">
                <button class="btn-cancelar-crear" @onclick="Cerrar">
                    Cancelar
                </button>

                <button class="btn-guardar-crear"
                        disabled="@(!PuedeGuardar || Guardando)"
                        @onclick="GuardarCarpeta">
                    @if (Guardando)
                    {
                        <span class="spinner-crear"></span>
                        <span>Creando...</span>
                    }
                    else
                    {
                        <span>📁 Crear</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<style>
    .custom-select-container {
        position: relative;
        width: 100%;
        margin-bottom: 10px;
    }

    .custom-select-trigger {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 12px;
        background: #fff;
        border: 1px solid #ccc;
        border-radius: 6px;
        cursor: pointer;
        font-size: 14px;
    }

    .custom-select-menu {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 99;
        background: #fff;
        border: 1px solid #ccc;
        border-radius: 6px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.15);
        margin-top: 4px;
    }

    .search-box-inside {
        padding: 8px;
        border-bottom: 1px solid #eee;
    }

    .input-search-dropdown {
        width: 100%;
        padding: 6px 10px;
        border: 1px solid #ddd;
        border-radius: 4px;
        outline: none;
        box-sizing: border-box;
    }

    .custom-select-options {
        list-style: none;
        margin: 0;
        padding: 0;
        max-height: 180px;
        overflow-y: auto;
    }

        .custom-select-options li {
            padding: 8px 12px;
            cursor: pointer;
            font-size: 14px;
        }

            .custom-select-options li:hover {
                background-color: #f0f4f8;
            }

            .custom-select-options li.selected {
                background-color: #e2e8f0;
                font-weight: bold;
            }
</style>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string IdCarpetaPadre { get; set; } = "root";
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnCarpetaCreada { get; set; }

    private bool Cargando;
    private bool Guardando;
    private bool GuardadoCorrectamente;
    private bool _visibleAnterior;

    private int? DropdownAbiertoIndice;
    private string TextoBusqueda = string.Empty;

    private List<UbicacionDTO> Ubicaciones = new();
    private List<List<UbicacionDTO>> Niveles = new();
    private List<UbicacionDTO?> Seleccionados = new();

    private UbicacionDTO? CarpetaSeleccionada;
    private string NombreCarpeta = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (Visible && !_visibleAnterior)
        {
            await CargarUbicacionesFrescas();
        }

        _visibleAnterior = Visible;
    }

    private async Task CargarUbicacionesFrescas()
    {
        Cargando = true;
        StateHasChanged();
        Ubicaciones = await ArchivoService.ObtenerUbicaciones();

        Niveles.Clear();
        Seleccionados.Clear();

        if (Ubicaciones.Any())
        {
            Niveles.Add(Ubicaciones);
        }

        string idInicial = string.IsNullOrWhiteSpace(IdCarpetaPadre) ? "root" : IdCarpetaPadre;
        CarpetaSeleccionada = new UbicacionDTO { IdSharePoint = idInicial };

        Cargando = false;
        StateHasChanged();
    }

    private void ToggleDropdown(int indice)
    {
        if (DropdownAbiertoIndice == indice)
        {
            DropdownAbiertoIndice = null;
        }
        else
        {
            DropdownAbiertoIndice = indice;
            TextoBusqueda = string.Empty;
        }
    }

    private List<UbicacionDTO> ObtenerOpcionesFiltradas(int nivel)
    {
        var listaBase = Niveles[nivel];
        if (string.IsNullOrWhiteSpace(TextoBusqueda))
            return listaBase;

        return listaBase.Where(x => x.Nombre != null && x.Nombre.Contains(TextoBusqueda, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private string ObtenerTextoSeleccionado(int nivel)
    {
        if (Seleccionados.Count > nivel && Seleccionados[nivel] != null)
        {
            return Seleccionados[nivel]!.Nombre;
        }

        return nivel == 0 ? "📁 Carpeta Raíz (Principal)" : "Seleccione...";
    }

    private void SeleccionarOpcion(int nivel, string valor, string nombre)
    {
        DropdownAbiertoIndice = null;
        TextoBusqueda = string.Empty;

        SeleccionarNivel(nivel, valor);
    }

    private void SeleccionarNivel(int nivel, string? valor)
    {
        while (Niveles.Count > nivel + 1)
            Niveles.RemoveAt(nivel + 1);

        while (Seleccionados.Count > nivel)
            Seleccionados.RemoveAt(nivel);

        if (nivel == 0 && valor == "root")
        {
            CarpetaSeleccionada = new UbicacionDTO { IdSharePoint = "root" };
            return;
        }

        if (string.IsNullOrWhiteSpace(valor))
        {
            CarpetaSeleccionada = nivel == 0 ? new UbicacionDTO { IdSharePoint = "root" } : Seleccionados.LastOrDefault();
            return;
        }

        var listaOrigen = Niveles[nivel];
        var seleccionado = listaOrigen.FirstOrDefault(x => x.IdSharePoint == valor);

        if (seleccionado != null)
        {
            Seleccionados.Add(seleccionado);
            CarpetaSeleccionada = seleccionado;

            if (seleccionado.Hijos != null && seleccionado.Hijos.Any())
            {
                Niveles.Add(seleccionado.Hijos);
            }
        }
    }

    private bool PuedeGuardar
    {
        get
        {
            if (CarpetaSeleccionada == null || string.IsNullOrWhiteSpace(CarpetaSeleccionada.IdSharePoint))
                return false;

            return !string.IsNullOrWhiteSpace(NombreCarpeta);
        }
    }

    private async Task GuardarCarpeta()
    {
        if (CarpetaSeleccionada == null || string.IsNullOrWhiteSpace(NombreCarpeta))
            return;

        try
        {
            Guardando = true;

            string? idPadreEnviar = CarpetaSeleccionada.IdSharePoint == "root"
                                    ? null
                                    : CarpetaSeleccionada.IdSharePoint;

            var dto = new CrearCarpetaDTO
            {
                Nombre = NombreCarpeta,
                IdCarpetaPadre = idPadreEnviar
            };

            bool exito = await ArchivoService.CrearCarpeta(dto);

            if (exito)
            {
                GuardadoCorrectamente = true;
                StateHasChanged();

                await Task.Delay(900);
                await Limpiar();
                await OnCarpetaCreada.InvokeAsync();
                await Cerrar();
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"No fue posible crear la carpeta.\n\n{ex.Message}");
        }
        finally
        {
            Guardando = false;
        }
    }

    private async Task Cerrar()
    {
        await Limpiar();
        await OnClose.InvokeAsync();
    }

    private Task Limpiar()
    {
        NombreCarpeta = string.Empty;
        TextoBusqueda = string.Empty;
        DropdownAbiertoIndice = null;
        GuardadoCorrectamente = false;
        Niveles.Clear();
        Seleccionados.Clear();

        Ubicaciones.Clear();

        CarpetaSeleccionada = new UbicacionDTO { IdSharePoint = "root" };

        return Task.CompletedTask;
    }
}