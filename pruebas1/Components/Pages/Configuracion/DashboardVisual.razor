        {
            var people = People.Where(p => p.AreaId == a.Id).ToList();
            var active = people.Count(p => p.Active);
            return new AreaRow(a.Id,a.Name,a.Short,a.Color,people.Count,active,people.Count == 0 ? 0 : (int)Math.Round(active*100.0/people.Count));
        }).Where(a => string.IsNullOrWhiteSpace(Active.Area) || a.Id == Active.Area);

