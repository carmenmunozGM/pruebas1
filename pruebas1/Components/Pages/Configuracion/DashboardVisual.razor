    private async Task ApplyFilters()
    {
        Active = new FilterState(
            Year,
            MonthFrom,
            MonthTo,
            AreaFilter,
            PersonFilter
        );

        await Task.WhenAll(
            CargarAdopcionAsync(
                Active.Year,
                Active.MonthFrom,
                Active.MonthTo,
                Active.Area,
                Active.Person
            ),
            CargarAutoevaluacionesPorPeriodoAsync(),
            CargarTareasPeriodoAsync()
        );
    }

    private async Task ClearFilters()
    {
        Year = "2026";
        MonthFrom = "";
        MonthTo = "";
        AreaFilter = "";
        PersonFilter = "";

        Active = new FilterState("2026", "", "", "", "");

        await Task.WhenAll(
            CargarAdopcionAsync(
                Active.Year,
                Active.MonthFrom,
                Active.MonthTo,
                Active.Area,
                Active.Person),

            CargarTareasPeriodoAsync()
        );
    }
