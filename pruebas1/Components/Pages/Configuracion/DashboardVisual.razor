    private string PeriodLabel
    {
        get
        {
            var desde = Months.FirstOrDefault(m => m.Value == Active.MonthFrom)?.Label ?? "Agosto";
            var hasta = Months.FirstOrDefault(m => m.Value == Active.MonthTo)?.Label ?? "Agosto";

            if (Active.MonthFrom == Active.MonthTo)
                return $"{desde} {Active.Year}";

            return $"{desde} - {hasta} {Active.Year}";
        }
    }
    private int Scoped(int value) => (int)Math.Round(value * ScopeFactor);

    private string AreaShort(string id) => Areas.FirstOrDefault(a => a.Id == id)?.Short ?? id;

    private static int Percent(int value, int total) => total <= 0 ? 0 : (int)Math.Round(value * 100.0 / total);

    private static string DonutStyle(int value, string color) =>
        $"background:conic-gradient({color} 0 {Math.Clamp(value, 0, 100)}%,#eceef5 {Math.Clamp(value, 0, 100)}% 100%)";

    private string TaskDonutStyle()
    {
        int total = TaskCompleted + TaskPending + TaskDays;
        if (total == 0) return "background: conic-gradient(#e5e7eb 0% 100%);";

        double a1 = (double)TaskCompleted / total * 100;
        double a2 = a1 + (double)TaskPending / total * 100;

        return $"background: conic-gradient(#8b5cf6 0% {a1:0.##}%, #f59e0b {a1:0.##}% {a2:0.##}%, #ef4444 {a2:0.##}% 100%);";
    }
    protected override async Task OnInitializedAsync()
    {

        try
        {

            await CargarAutoevaluacionesPorPeriodoAsync();

            var m = TaskDuracionList.FirstOrDefault();

            var resumenAe = await AutoevaluacionService.ObtenerResumenAutoevaluacionAsync();
            if (resumenAe != null)
            {
                AeExpectedApi = resumenAe.aeExpected;
                AeRegisteredApi = resumenAe.aeRegistered;
                AeNotRegisteredApi = resumenAe.aeNotRegistered;
                AeComplianceApi = resumenAe.aeCompliance;
            }
            var detalle = await AutoevaluacionService.ObtenerDetalleIndividualAsync();
            DetalleEmpleados = detalle.GroupBy(p => p.Id).Select(g => g.First()).ToList();

            // Totales de tareas
            var resTotal = await TotalTareasService.ObtenerTotalTareasAsync();
            if (resTotal != null) TotalTareasApi = resTotal.TotalTareas;

            var resPendientes = await TotalTareasService.ObtenerTotalPendientesAsync();
            if (resPendientes != null) TotalPendientesApi = resPendientes.TotalPendientes;

            var resCompletadas = await TotalTareasService.ObtenerTotalCompletadasAsync();
            if (resCompletadas != null) TotalCompletadasApi = resCompletadas.TotalCompletadas;

            var resVencidas = await TotalTareasService.ObtenerTotalVencidasAsync();
            if (resVencidas != null) TotalVencidasApi = resVencidas.TotalVencidas;

            TotalDiasRecorridosApi = await TareasDuracionService.ObtenerSumaDiasRecorridos();

            var duracion = await TareasDuracionService.ObtenerDuracionTareas();
            TaskDuracionList = duracion?.ToList() ?? new List<TareaDuracionDTO>();

            PeopleRows = await TareasDuracionService.ObtenerDetalleIndividualEmpleados();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar datos: {ex.Message}");
        }

        AreasFiltro = await AreasService.GetAreas();
        Empleados = await EmpleadosService.GetEmpleados();

        EmpleadosPorId = Empleados
            .GroupBy(e => e.Id)
            .ToDictionary(g => g.Key, g => g.First());

        EmpleadosPorRed = Empleados
        .Where(e => !string.IsNullOrWhiteSpace(e.NombreRed))
        .GroupBy(e => NormRed(e.NombreRed))
        .ToDictionary(g => g.Key, g => g.First());

        await CargarAdopcionAsync(Year, MonthFrom, MonthTo, AreaFilter, PersonFilter);

        try
        {
            var catalogo = await AdopcionAgendaService.ObtenerAdopcionAsync(
                int.Parse(Year), 1, 12, null, null);

            AdopcionPorId = catalogo.Empleados
                .GroupBy(e => e.IdEmpleado)
                .ToDictionary(g => g.Key, g => g.First());

            ConstruirAlias();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando catálogo de adopción: {ex.Message}");
        }
        StateHasChanged();
    }


