    private static string NormRed(string? s) =>
    Norm((s ?? "").Split('\\').Last());
    private Dictionary<int, AdopcionEmpleadoDTO> AdopcionPorId = new();

    private Dictionary<string, (string Nombre, string Area)> AliasPorUsuario = new();

    private static IEnumerable<string> AliasesDe(string? nombre)
    {
        var t = Norm(nombre).Split(' ', StringSplitOptions.RemoveEmptyEntries);
        for (int i = 1; i < t.Length; i++)
            yield return t[0] + t[i];
    }
    private (DateTime Desde, DateTime Hasta) ObtenerPeriodoAutoevaluacion()
    {
        int anio = int.Parse(Active.Year);

        int mesDesde = string.IsNullOrWhiteSpace(Active.MonthFrom)
            ? 1
            : int.Parse(Active.MonthFrom);

        int mesHasta = string.IsNullOrWhiteSpace(Active.MonthTo)
            ? 12
            : int.Parse(Active.MonthTo);

        DateTime desde = new DateTime(anio, mesDesde, 1);
        DateTime hasta = new DateTime(anio, mesHasta, 1).AddMonths(1);

        return (desde, hasta);
    }

    private void ConstruirAlias()
    {
        var tmp = new Dictionary<string, List<AdopcionEmpleadoDTO>>();
        foreach (var e in AdopcionPorId.Values)
            foreach (var alias in AliasesDe(e.Nombre).Distinct())
            {
                if (!tmp.TryGetValue(alias, out var lista))
                    tmp[alias] = lista = new();
                lista.Add(e);
            }

        AliasPorUsuario = tmp
            .Where(kv => kv.Value.Select(x => Norm(x.Nombre)).Distinct().Count() == 1)
            .ToDictionary(kv => kv.Key, kv => (kv.Value[0].Nombre, kv.Value[0].Area));
    }

    private (string Nombre, string Area)? Persona(TareaDuracionDTO t)
    {
        if (AdopcionPorId.TryGetValue(t.EmpleadoId, out var a))
            return (a.Nombre, a.Area);

        var user = NormRed(ClaveDeTarea(t));
        if (EmpleadosPorRed.TryGetValue(user, out var e))
            return (e.Nombre, e.Area);

        if (AliasPorUsuario.TryGetValue(user.Replace(" ", ""), out var al))
            return al;

        return null;
    }

    private int TotalCombinado => TaskCompleted + TaskPending + TaskDays;
    private IEnumerable<EmpleadoDetalleDTO> PeopleRows = new List<EmpleadoDetalleDTO>();

    private double PctCompletadas => TotalCombinado == 0 ? 0 : Math.Round((double)TaskCompleted * 100 / TotalCombinado, 1);
    private double PctPendientes => TotalCombinado == 0 ? 0 : Math.Round((double)TaskPending * 100 / TotalCombinado, 1);
    private double PctDiasRecorridos => TotalCombinado == 0 ? 0 : Math.Round((double)TaskDays * 100 / TotalCombinado, 1);

    private bool EnCatalogo(int id) => AdopcionPorId.ContainsKey(id);

    private bool TareaResuelta(TareaDuracionDTO t) => Persona(t) != null;

    private IEnumerable<TaskArea> TaskAreas =>
    TareasDuracionFiltradas // Eliminamos el .Where(TareaResuelta) para que no oculte registros
        .GroupBy(t => Norm(AreaDeTarea(t)))
        .Select(g => new TaskArea(
            AreaDeTarea(g.First()),
            g.Count(),
            g.Count(t => t.Completada && t.DiasRecorridos == 0),
            g.Count(t => !t.Completada),
            g.Count(t => t.DiasRecorridos > 0)
        ))
        .OrderBy(a => a.Name);

    private record FilaPersona(string Nombre, string Area,
    int Registradas, int EnFecha, int Pendientes, int Vencidas, double Cumplimiento);

    private IEnumerable<FilaPersona> TareasPersonas =>
    TareasDuracionFiltradas
        .Where(TareaResuelta)
        .GroupBy(t => Norm(NombreDeTarea(t)))
        .Select(g =>
        {
            var first = g.First();

            int enFecha = g.Count(t => t.Completada && t.DiasRecorridos == 0);
            int pendientes = g.Count(t => !t.Completada && t.DiasRecorridos == 0);
            int vencidas = g.Count(t => t.DiasRecorridos > 0);
            int registradas = enFecha + pendientes + vencidas;

            return new FilaPersona(
                NombreDeTarea(first),
                AreaDeTarea(first),
                registradas,
                enFecha,
                pendientes,
                vencidas,
                registradas == 0 ? 0 : Math.Round(enFecha * 100.0 / registradas, 1)
            );
        })
        .OrderBy(f => f.Nombre);

    private static string ClaveDeTarea(TareaDuracionDTO t) =>
    (t.EmpleadoNombre ?? "").Replace("Empleado ID:", "").Trim();

    private string AeNombre(TotalAutoevaluacionesDTO p)
    {
        if (AdopcionPorId.TryGetValue(p.Id, out var a) && !string.IsNullOrWhiteSpace(a.Nombre))
            return a.Nombre;

        return !string.IsNullOrWhiteSpace(p.Nombre) ? p.Nombre : $"Empleado #{p.Id}";
    }

    private string AeArea(TotalAutoevaluacionesDTO p)
    {
        if (AdopcionPorId.TryGetValue(p.Id, out var a) && !string.IsNullOrWhiteSpace(a.Area))
            return a.Area;

        return !string.IsNullOrWhiteSpace(p.Area) ? p.Area : "SIN CLASIFICAR";
    }

    private static double AeCump(TotalAutoevaluacionesDTO p) => Math.Round((double)p.Cumplimiento, 1);

    private string NombreDeTarea(TareaDuracionDTO t) =>
        Persona(t)?.Nombre is { Length: > 0 } n ? n
        : (string.IsNullOrWhiteSpace(t.EmpleadoNombre) ? $"Empleado #{t.EmpleadoId}" : t.EmpleadoNombre);

    private string AreaDeTarea(TareaDuracionDTO t) =>
        Persona(t) is { } p && !string.IsNullOrWhiteSpace(p.Area) ? p.Area
        : (string.IsNullOrWhiteSpace(t.Area) ? "SIN CLASIFICAR" : t.Area);


    // ===== FILTROS COMPARTIDOS =====
    private bool HayFiltro =>
        !string.IsNullOrWhiteSpace(Active.Area) || !string.IsNullOrWhiteSpace(Active.Person);

    private string? AreaActivaNombre =>
        string.IsNullOrWhiteSpace(Active.Area)
            ? null
            : AreasFiltro.FirstOrDefault(a => a.Clave.ToString() == Active.Area)?.Area;

    private string ResumenFiltro =>
        !string.IsNullOrWhiteSpace(Active.Person) ? Active.Person : AreaActivaNombre ?? "";

    private bool CoincideEmpleado(int empleadoId)
    {
        if (!HayFiltro) return true;
        if (!EmpleadosPorId.TryGetValue(empleadoId, out var emp)) return false;

        if (AreaActivaNombre != null && Norm(emp.Area) != Norm(AreaActivaNombre)) return false;
        if (HayPersona && Norm(emp.Nombre) != Norm(Active.Person)) return false;
        return true;
    }


    // ===== TAREAS =====
    private static string Norm(string? s) =>
    new string((s ?? "").Normalize(System.Text.NormalizationForm.FormD)
        .Where(c => System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c)
                    != System.Globalization.UnicodeCategory.NonSpacingMark)
        .ToArray()).Trim().ToUpperInvariant();

    private bool HayPersona => !string.IsNullOrWhiteSpace(Active.Person);

    private IEnumerable<TareaDuracionDTO> TareasDuracionFiltradas =>
    TaskDuracionList.Where(t =>
    {
        // 1. Filtro por Área
        if (AreaActivaNombre != null && Norm(AreaDeTarea(t)) != Norm(AreaActivaNombre))
            return false;

        // 2. Filtro por Persona
        if (HayPersona && Norm(NombreDeTarea(t)) != Norm(Active.Person))
            return false;

        // 3. Filtro estricto por Periodo
        if (!string.IsNullOrWhiteSpace(Active.Year) && int.TryParse(Active.Year, out int anioFiltro))
        {
            int mesDesde = string.IsNullOrWhiteSpace(Active.MonthFrom) ? 1 : int.Parse(Active.MonthFrom);
            int mesHasta = string.IsNullOrWhiteSpace(Active.MonthTo) ? 12 : int.Parse(Active.MonthTo);

            if (t.FechaInicio.HasValue)
            {
                if (t.FechaInicio.Value.Year != anioFiltro) return false;
                if (t.FechaInicio.Value.Month < mesDesde || t.FechaInicio.Value.Month > mesHasta) return false;
            }
            else
            {
                return false;
            }
        }

        return true;
    });

    private int TaskTotal => TareasDuracionFiltradas.Count();

    private int TaskPending =>
    TareasDuracionFiltradas.Count(t => !t.Completada);

    private int TaskCompleted =>
        TareasDuracionFiltradas.Count(t => t.Completada);

    private int TaskDays =>
        TareasDuracionFiltradas.Sum(t => t.DiasRecorridos);

    private int TaskOverdue => DelayBuckets.Sum(b => b.Value);
    private int TaskOnTime => Math.Max(0, TaskTotal - TaskPending - TaskOverdue);
    private double PorcentajeDiasRecorridos =>
        TaskTotal == 0 ? 0 : Math.Round((double)TaskDays / TaskTotal * 100, 1);

    private List<DelayBucket> DelayBuckets
    {
        get
        {
            var r = TareasDuracionFiltradas.Where(t => t.DiasRecorridos > 0).ToList();

            int b1 = r.Where(t => t.DiasRecorridos >= 1 && t.DiasRecorridos <= 90).Sum(t => t.DiasRecorridos);
            int b2 = r.Where(t => t.DiasRecorridos >= 91 && t.DiasRecorridos <= 180).Sum(t => t.DiasRecorridos);
            int b3 = r.Where(t => t.DiasRecorridos >= 181 && t.DiasRecorridos <= 270).Sum(t => t.DiasRecorridos);
            int b4 = r.Where(t => t.DiasRecorridos >= 271 && t.DiasRecorridos <= 365).Sum(t => t.DiasRecorridos);
            int b5 = r.Where(t => t.DiasRecorridos > 365).Sum(t => t.DiasRecorridos);

            int sumaParcial = b2 + b3 + b4 + b5;
            int ajustadoB1 = Math.Max(0, TaskDays - sumaParcial);

            return new()
        {
            new("1 día - 3 meses", ajustadoB1, "#3b82f6"),
            new("3 meses - 6 meses", b2, "#f59e0b"),
            new("6 meses - 9 meses", b3, "#10b981"),
            new("9 meses - 12 meses", b4, "#6366f1"),
            new("Más de 1 año", b5, "#ef4444")
        };
        }
    }

