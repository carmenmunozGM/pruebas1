    private IEnumerable<TotalAutoevaluacionesDTO> AeFiltrados =>
    !HayFiltro ? DetalleEmpleados
    : DetalleEmpleados
        .Where(p => AreaActivaNombre == null || Norm(AeArea(p)) == Norm(AreaActivaNombre))
        .Where(p => !HayPersona || Norm(AeNombre(p)) == Norm(Active.Person));

