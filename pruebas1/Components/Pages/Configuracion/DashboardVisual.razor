    private static int Percent(int value,int total) => total <= 0 ? 0 : (int)Math.Round(value*100.0/total);

    private static string DonutStyle(int value,string color) =>
        $"background:conic-gradient({color} 0 {Math.Clamp(value,0,100)}%,#eceef5 {Math.Clamp(value,0,100)}% 100%)";

    private string TaskDonutStyle()
    {
        var a = TaskTotal == 0 ? 0 : TaskOnTime*100.0/TaskTotal;
        var b = TaskTotal == 0 ? a : a + TaskPending*100.0/TaskTotal;
        return $"background:conic-gradient(#7f83d9 0 {a:F1}%,#e0ad68 {a:F1}% {b:F1}%,#d98d8d {b:F1}% 100%)";
    }

    private static string BarStyle(double value,string color) =>
        $"width:{Math.Clamp(value,0,100):F0}%;background:{color};";

    private static string TrendPointStyle(int value) =>
        $"bottom:{Math.Clamp((value-65)*2.2,8,42):F0}px;";

    private static string ColumnStyle(int value) =>
        $"height:{Math.Clamp(value/45.0*100,5,100):F0}%;background:#a9b8d8;";

    private static string HeightStyle(int value,int max) =>
        $"height:{Math.Clamp(value/(double)max*100,8,100):F0}%;";

    private static string WidthStyle(int value,int max) =>
        $"width:{Math.Clamp(value/(double)max*100,3,100):F0}%";

    private static string OldColor(int days) => days > 90 ? "#a65b5b" : days > 30 ? "#a6783d" : "#5b6b92";
    private static string OldBackground(int days) => days > 90 ? "#fbefef" : days > 30 ? "#fbf5e9" : "#f0f3fa";

    private int ScopedOrderValue(int value) =>
