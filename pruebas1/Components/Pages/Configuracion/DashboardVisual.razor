@page "/dashboard"
@using pruebas1.Servicios
@using pruebas1.Components.DTOs
@inject AreasService AreasService
@inject EmpleadosService EmpleadosService
@inject AdopcionAgendaService AdopcionAgendaService
@inject TotalTareasService TotalTareasService
@inject TareasDuracionService TareasDuracionService
@inject AutoevaluacionService AutoevaluacionService

@using APIProyectoSPEC.DTOs

<div class="dashboard-shell">
    <div class="dashboard-content">

        <div class="dashboard-heading">
            <div>
                <div class="eyebrow">AGENDA GM </div>
                <h1>DASHBOARD</h1>
                <p>Uso de la aplicación, tareas, órdenes, autoevaluación y servicio al cliente en una sola lectura.</p>
            </div>

        </div>

        <section class="dash-card filters-card">
            <div class="filters-title">
                <span>⚙️</span>
                <div>
                    <div class="section-card-title">Filtros de consulta</div>
                    <div class="muted">Selecciona el alcance y después aplica para actualizar el dashboard.</div>
                </div>
            </div>

            <div class="filters-grid">
                <label>
                    AÑO

                    <select @bind="Year">

                        @foreach (var year in Years)
                        {
                            <option value="@year">@year</option>
                        }
                    </select>
                </label>


                <label>
                    PERIODO DESDE
                    <select @bind="MonthFrom">
                        <option value="">Selecciona mes</option>
                        @foreach (var m in Months)
                        {
                            <option value="@m.Value">@m.Label</option>
                        }
                    </select>
                </label>

                <label>
                    PERIODO HASTA
                    <select @bind="MonthTo">
                        <option value="">Selecciona mes</option>
                        @foreach (var m in Months)
                        {
                            <option value="@m.Value">@m.Label</option>
                        }
                    </select>
                </label>

                <label>
                    ÁREA
                    <select @bind="AreaFilter" @bind:after="AreaChanged">
                        <option value="">Todo el despacho</option>

                        @foreach (var area in AreasFiltro)
                        {
                            <option value="@area.Clave">@area.Area</option>
                        }
                    </select>
                </label>

                <label>
                    PERSONA
                    <select @bind="PersonFilter">
                        <option value="">Todas las personas</option>
                        @foreach (var empleado in Empleados.Where(e =>
                                                string.IsNullOrWhiteSpace(AreaFilter) ||
                                                e.Area == AreasFiltro.FirstOrDefault(a => a.Clave.ToString() == AreaFilter)?.Area))
                        {
                            <option value="@empleado.Nombre">@empleado.Nombre</option>
                        }
                    </select>
                </label>

                <div class="filter-actions">
                    <button class="btn-primary" @onclick="ApplyFilters">✓ Aplicar filtros</button>
                    <button class="btn-secondary" @onclick="ClearFilters">↺ Limpiar</button>
                </div>

            </div>

            @if (!string.IsNullOrWhiteSpace(Active.Area) || !string.IsNullOrWhiteSpace(Active.Person))
            {
                <div class="filter-summary">
                    🔎 Vista filtrada · @(string.IsNullOrWhiteSpace(Active.Person)
                                                                        ? Areas.FirstOrDefault(a => a.Id == Active.Area)?.Name
                                                                        : Active.Person)
                </div>
            }
        </section>

        <!-- 01 ADOPCIÓN -->
        <section class="dash-section">

            <div class="section-heading">

                @if (!string.IsNullOrWhiteSpace(ErrorTareas))
                {
                    <p class="metric-detail red">@ErrorTareas</p>
                }

                @if (CargandoAdopcion)
                {
                    <p class="muted">Cargando datos de Adopción de Agenda...</p>
                }

                @if (!string.IsNullOrWhiteSpace(ErrorAdopcion))
                {
                    <p class="metric-detail red">@ErrorAdopcion</p>
                }
                <div class="section-number">01</div>
                <div>
                    <h2>👥 Uso de la agenda gm</h2>
                    <p>Total de ingresos y usuarios activos para comprobar si la plataforma realmente se utiliza.</p>
                </div>
            </div>

            <div class="metric-grid adoption-grid">
                <div class="dash-card adoption-card">
                    <div class="donut" style="@DonutStyle((int)Math.Round(AdopcionDatos.PorcentajeAdopcion), "#6366c1")">
                        <div class="donut-inner">@AdopcionDatos.PorcentajeAdopcion.ToString("F1")%</div>
                    </div>
                    <div>
                        <div class="metric-label">Adopción</div>
                        <div class="metric-big">@AdopcionDatos.EmpleadosConActividad de @AdopcionDatos.TotalEmpleados</div>
                        <div class="metric-detail purple">empleados con actividad</div>
                    </div>
                </div>

                <div class="metric-card">
                    <div class="metric-label">🟢 Con actividad</div>
                    <div class="metric-value">@AdopcionDatos.EmpleadosConActividad</div>
                    <div class="metric-detail green">usan Agenda</div>
                </div>

                <div class="metric-card">
                    <div class="metric-label">⚪ Sin actividad</div>
                    <div class="metric-value">@AdopcionDatos.EmpleadosSinActividad</div>
                    <div class="metric-detail red">sin registro</div>
                </div>

            </div>

            <div class="two-columns">
                <div class="dash-card chart-card">
                    <div class="chart-title">
                        <span>📊</span>
                        <div><h3>Adopción por área</h3><p>Porcentaje de personas con actividad.</p></div>
                    </div>


                    <div class="horizontal-bars">
                        @foreach (var area in AdopcionDatos.Areas)
                        {
                            var color = Areas.FirstOrDefault(a =>
                            a.Name == area.Area || a.Short == area.Area)?.Color ?? "#7f83d9";

                            var nombreCorto = Areas.FirstOrDefault(a =>
                            a.Name == area.Area || a.Short == area.Area)?.Short ?? area.Area;

                            <div class="hbar-row">
                                <span>@nombreCorto</span>
                                <div class="bar-track">
                                    <div class="bar-fill"
                                         style="@BarStyle(area.PorcentajeAdopcion, color)">
                                    </div>
                                </div>
                                <b>@area.PorcentajeAdopcion.ToString("F1")%</b>
                            </div>
                        }
                    </div>
                </div>
                <div class="dash-card chart-card">
                    <div class="chart-title">
                        <span>📈</span>
                        <div>
                            <h3>Tendencia de uso</h3>
                            <p>Evolución mensual de adopción.</p>
                        </div>
                    </div>

                    <!-- Contenedor del Gráfico SVG -->
                    <div class="chart-container" style="position: relative; width: 100%; height: 210px;">
                        <svg viewBox="0 0 750 200" preserveAspectRatio="none" style="width: 100%; height: 100%; overflow: visible;">

                            <!-- Líneas de la cuadrícula de fondo -->
                            <line x1="0" y1="20" x2="750" y2="20" stroke="#f0f0f5" stroke-width="1" />
                            <line x1="0" y1="65" x2="750" y2="65" stroke="#f0f0f5" stroke-width="1" />
                            <line x1="0" y1="110" x2="750" y2="110" stroke="#f0f0f5" stroke-width="1" />
                            <line x1="0" y1="155" x2="750" y2="155" stroke="#f0f0f5" stroke-width="1" />

                            @{
                                var items = AdopcionDatos.TendenciaMensual.ToList();
                                int total = items.Count;
                                if (total > 1)
                                {
                                    string lineString = "";
                                    string areaPath = "";
                                    var coords = new List<(double x, double y, int porcentaje, string mes)>();

                                    for (int i = 0; i < total; i++)
                                    {
                                        double x = (double)i / (total - 1) * 700 + 25;

                                        // Soporte seguro: si el porcentaje viene como decimal (ej. 0.85) o entero (85)
                                        double rawPorc = items[i].PorcentajeAdopcion;
                                        int porc = rawPorc <= 1.0 && rawPorc > 0 ? (int)Math.Round(rawPorc * 100) : (int)Math.Round(rawPorc);

                                        // Mapeo vertical (100% arriba, 0% abajo)
                                        double y = 175 - (porc / 100.0 * 155);
                                        coords.Add((x, y, porc, items[i].NombreMes));
                                    }

                                    // Curva fluida Bézier
                                    lineString = $"M {coords[0].x} {coords[0].y}";
                                    for (int i = 0; i < coords.Count - 1; i++)
                                    {
                                        var p1 = coords[i];
                                        var p2 = coords[i + 1];
                                        double xc = (p1.x + p2.x) / 2;
                                        lineString += $" Q {xc} {p1.y}, {p2.x} {p2.y}";
                                    }

                                    areaPath = $"{lineString} L {coords.Last().x} 180 L {coords.First().x} 180 Z";

                                    <!-- Relleno translúcido -->
                                    <path d="@areaPath" fill="rgba(99, 102, 193, 0.08)" />

                                    <!-- Línea de tendencia -->
                                    <path d="@lineString" fill="none" stroke="#6366c1" stroke-width="3" stroke-linecap="round" />

                                    <!-- Puntos -->
                                    @for (int i = 0; i < coords.Count; i++)
                                    {
                                        var pt = coords[i];
                                        <circle cx="@pt.x" cy="@pt.y" r="4.5" fill="white" stroke="#6366c1" stroke-width="3" />
                                    }
                                }
                            }
                        </svg>
                    </div>

                    <!-- Etiquetas del Eje X abreviadas automáticamente a 3 letras -->
                    <div class="trend-labels" style="display: flex; justify-content: space-between; margin-top: 12px; padding: 0 5px;">
                        @foreach (var item in AdopcionDatos.TendenciaMensual)
                        {
                            var nombreMes = item.NombreMes;
                            var mesCorto = nombreMes.Length > 3 ? nombreMes.Substring(0, 3).ToUpper() : nombreMes.ToUpper();
                            <span style="font-size: 10px; color: #7b8494; font-weight: 700; text-align: center; flex: 1;">@mesCorto</span>
                        }
                    </div>
                </div>
            </div>

            <div class="dash-card table-card">
                <div class="table-header">
                    <div><h3>🧑‍💼 Uso individual</h3><p>Quién entra a la Agenda y quién no.</p></div>
                    <span class="small-badge">    @AdopcionDatos.Empleados.Count personas</span>
                </div>
                <div class="table-scroll">
                    <table>
                        <thead>
                            <tr>
                                <th>Empleado</th>
                                <th>Área</th>
                                <th>Días</th>
                                <th>Ultima Fecha</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var p in AdopcionDatos.Empleados)
                            {
                                <tr>
                                    <td>@p.Nombre</td>
                                    <td>@p.Area</td>
                                    <td>@p.AccesosRegistrados</td>
                                    <td>@(p.UltimoAcceso?.ToString("dd/MM/yyyy") ?? "Sin registro")</td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- 02 TAREAS -->
        <section class="dash-section">
            <div class="section-heading">
                <div class="section-number">02</div>
                <div>
                    <h2>📝 Bloque de Tareas</h2>
                    <p>Carga, cumplimiento de fecha y retraso. La lectura sigue despacho → área → empleado.</p>
                </div>
            </div>

            @if (HayFiltro)
            {
                <div class="filter-summary">🔎 Vista filtrada · @ResumenFiltro</div>
            }

            <div class="metric-grid four">
                <div class="metric-card"><div class="metric-label">📋 Registradas</div><div class="metric-value">@TaskTotal</div></div>
                <div class="metric-card"><div class="metric-label">⏳ Pendientes</div><div class="metric-value">@TaskPending</div><div class="metric-detail gray">@TaskPendingPct% del total</div></div>
                <div class="metric-card"><div class="metric-label">✓ Completadas</div><div class="metric-value">@TaskCompleted</div><div class="metric-detail green">@(TaskTotal == 0 ? 0 : Math.Round((double)TaskCompleted * 100 / TaskTotal, 1))% del total</div></div>
                <div class="metric-card"><div class="metric-label">⚠ Días Recorridos</div><div class="metric-value">@TaskDays</div><div class="metric-detail red">@PorcentajeDiasRecorridos% del total</div></div>
            </div>

            <div class="two-columns task-columns">
                <div class="dash-card chart-card">
                    <div class="chart-title"><span>🍩</span><div><h3>Estado de tareas</h3><p>Distribución del trabajo.</p></div></div>
                    <div class="donut-panel" style="position: relative; display: flex; align-items: center; justify-content: space-around; padding: 20px 0;"><div style="position: relative; width: 180px; height: 180px; display: flex; align-items: center; justify-content: center;">
                    <div class="donut task-donut" style="@TaskDonutStyle(); width: 180px; height: 180px; border-radius: 50%;">
                    <div class="donut-inner" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center;"><span style="font-size: 1.2rem; font-weight: bold; color: #1f2937;">@TaskTotal</span></div></div>
                            <span style="position: absolute; top: 10px; right: -25px; color: #8b5cf6; font-weight: bold; font-size: 0.85rem; background: #fff; padding: 2px 6px; border-radius: 6px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">@PctCompletadas%</span>
                            <span style="position: absolute; bottom: 20px; right: -25px; color: #f59e0b; font-weight: bold; font-size: 0.85rem; background: #fff; padding: 2px 6px; border-radius: 6px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">@PctPendientes%</span>
                            <span style="position: absolute; top: 50%; left: -35px; transform: translateY(-50%); color: #ef4444; font-weight: bold; font-size: 0.85rem; background: #fff; padding: 2px 6px; border-radius: 6px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">@PctDiasRecorridos%</span></div>
                    <div class="legend-list" style="flex-grow: 1; max-width: 260px; margin-left: 20px;">
                            <div><span><i class="legend-dot purple-bg"></i>Completadas</span><div><b style="color: #8b5cf6;">@TaskCompleted</b><span class="legend-pct" style="color: #8b5cf6;"></span></div></div>
                            <div><span><i class="legend-dot orange-bg"></i>Pendientes</span><div><b style="color: #f59e0b;">@TaskPending</b><span class="legend-pct" style="color: #f59e0b;"></span></div></div>
                            <div><span><i class="legend-dot red-bg"></i>Días Recorridos</span><div><b style="color: #ef4444;">@TaskDays</b><span class="legend-pct" style="color: #ef4444;"></span></div></div>
                        </div>
                    </div>
                </div>

                <div class="dash-card chart-card"><div class="chart-title"><span>⏱️</span><div><h3>Retraso sobre fecha comprometida</h3><p>Cuántos días después se terminó o sigue abierta.</p></div></div>
                            @foreach (var bucket in DelayBuckets)
                        {
                <div class="delay-item"><div class="delay-head"><span>@bucket.Label</span><b>@bucket.Value</b></div><div class="progress"><div class="progress-fill" style="@BarStyle(TaskOverdue == 0 ? 0 : bucket.Value * 100.0 / TaskOverdue, bucket.Color)"></div></div></div>
                        }
                </div>
            </div>

            <div class="dash-card table-card"><div class="table-header"><div><h3>🏢 Comparación por área</h3><p>Detalle de volumen y cumplimiento.</p></div></div><div class="table-scroll">
                    <table><thead><tr><th>Área</th><th>Registradas</th><th>En fecha</th><th>Pendientes</th><th>Vencidas</th><th>Cumplimiento</th></tr></thead><tbody>
                            @foreach (var a in FilteredTaskAreas)
                            {
                                <tr><td>@a.Name</td><td>@a.Total</td> <td>@a.OnTime</td><td>@a.Pending</td><td>@a.Overdue</td><td><span class="pill pill-purple">@Percent(a.OnTime, a.Total)%</span></td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="dash-card table-card table-gap">
            <div class="table-header"><div><h3>👤 Detalle individual</h3><p>Tareas registradas, cumplimiento y vencimientos por empleado.</p></div><span class="small-badge">@TareasPersonas.Count() personas</span></div>
            <div class="table-scroll"><table><thead><tr><th>Empleado</th><th>Área</th><th>Registradas</th><th>En fecha</th><th>Pendientes</th><th>Vencidas</th><th>Cumplimiento</th></tr></thead><tbody>
                            @foreach (var p in TareasPersonas)
                            {
                                <tr><td>@p.Nombre</td><td>@p.Area</td><td>@p.Registradas</td><td>@p.EnFecha</td><td>@p.Pendientes</td><td>@p.Vencidas</td><td><span class="pill pill-purple">@p.Cumplimiento.ToString("0.#")%</span></td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- 03 ORDENES -->
        <section class="dash-section">
            <div class="section-heading">
                <div class="section-number">03</div>
                <div><h2>📑Bloque de Órdenes de trabajo</h2><p>No solo cuántas están vencidas: antigüedad, acumulación, recuperación y detalle individual.</p></div>
            </div>

            <div class="metric-grid five">
                <div class="metric-card"><div class="metric-label">📦 Total</div><div class="metric-value">@OrderTotal</div></div>
                <div class="metric-card"><div class="metric-label">🔴 Vencidas</div><div class="metric-value">@OrderOverdue</div><div class="metric-detail red">requieren seguimiento</div></div>
                <div class="metric-card"><div class="metric-label">🟠 Próximas</div><div class="metric-value">@OrderUpcoming</div><div class="metric-detail orange">por vencer</div></div>
                <div class="metric-card"><div class="metric-label">📅 Hoy</div><div class="metric-value">@OrderToday</div><div class="metric-detail orange">atención inmediata</div></div>

            </div>

            <div class="two-columns">
                <div class="dash-card chart-card">
                    <div class="chart-title"><span>⏳</span><div><h3>Días de las órdenes vencidas</h3><p>Distribución de antigüedad.</p></div></div>
                    <div class="column-chart">
                        @foreach (var item in Aging)
                        {
                            var value = ScopedOrderValue(item.Value);
                            <div class="column-item">
                                <div class="column-value">@value</div>
                                <div class="column-bar-area"><div class="column-bar" style="@ColumnStyle(value)"></div></div>
                                <span>@item.Label</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="dash-card chart-card">
                    <div class="chart-title"><span>📈</span><div><h3>Histórico por mes / vencidas</h3><p>Órdenes vencidas acumuladas por periodo.</p></div></div>
                    <div class="backlog-chart">
                        @foreach (var item in Backlog)
                        {
                            var value = ScopedOrderValue(item.Value);
                            <div class="backlog-column">
                                <b>@value</b>
                                <div class="backlog-bar" style="@HeightStyle(value, 44)"></div>
                                <span>@item.Month</span>
                            </div>
                        }
                    </div>
                    <div class="last-period"><span>Último periodo</span><b>@ScopedOrderValue(44) vencidas</b></div>
                </div>
            </div>

            <div class="dash-card table-card table-gap">
                <div class="table-header"><div><h3>🏢 Comparación por área</h3><p>Volumen, vencimientos y carga histórica por área.</p></div></div>
                <div class="table-scroll">
                    <table>
                        <thead><tr><th>Área</th><th>Total</th><th>Atendidas</th><th>Próximas</th><th>Vencidas</th><th>Hoy</th><th>Vencidas +90d</th></tr></thead>
                        <tbody>
                            @foreach (var a in FilteredOrderAreas)
                            {
                                <tr><td>@a.Name</td><td>@a.Total</td><td>@a.Attended</td><td>@a.Upcoming</td><td>@a.Overdue</td><td>@a.Today</td><td>@(string.IsNullOrWhiteSpace(Active.Area) ? 1 : Math.Max(0, (int)Math.Round(3 * ScopeFactor)))</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="dash-card table-card table-gap">
                <div class="table-header"><div><h3>👤 Análisis individual</h3><p>Vencidas, atraso promedio, máxima antigüedad y recuperación por empleado.</p></div><span class="small-badge">@PeopleRows.Count() personas</span></div>
                <div class="table-scroll">
                    <table>
                        <thead><tr><th>Empleado</th><th>Área</th><th>Vencidas</th><th>Atraso promedio</th><th>Máximo atraso</th><th>Recuperadas</th></tr></thead>
                        <tbody>
                            @foreach (var p in FilteredOrderPeople)
                            {
                                <tr><td>@p.Name</td><td>@p.Area</td><td>@p.Overdue</td><td>@p.Avg días</td><td><span class="pill" style="color:@OldColor(p.Max);background:@OldBackground(p.Max)">@p.Max días</span></td><td>@p.Recovered</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- 04 AUTOEVALUACION -->
        <section class="dash-section">
        <div class="section-heading">
            <div class="section-number">04</div>
            <div><h2>📋Bloque de Autoevaluación</h2><p>Separamos tres cosas: cobertura del registro, cumplimiento de actividades y consistencia entre periodos.</p></div>
        </div>
        @if (HayFiltro)
        {
            <div class="filter-summary">🔎 Vista filtrada · @ResumenFiltro</div>
        }

        <div class="metric-grid ae-grid">
            <div class="dash-card adoption-card">
                <div class="donut" style="@DonutStyle((int)Math.Round(AeCoverage), "#7f83d9")"><div class="donut-inner">@AeCoverage.ToString("0.#")%</div></div>
                <div><div class="metric-label">Registraron</div><div class="metric-big">@AeRegistered/@AeExpected</div><div class="metric-detail purple">personas con registro</div></div>
            </div>
            <div class="metric-card"><div class="metric-label">✓ Registraron</div><div class="metric-value">@AeRegistered</div></div>
            <div class="metric-card"><div class="metric-label">⚪ No registraron</div><div class="metric-value">@AeNotRegistered</div></div>
            <div class="metric-card"><div class="metric-label">📈 Cumplimiento</div><div class="metric-value">@AeCompliance.ToString("0.#")%</div><div class="metric-detail purple">actividades declaradas</div></div>
        </div>
        <div class="dash-card table-card table-gap">
        <div class="table-header"><div><h3>👤 Detalle individual</h3><p>Registro y cumplimiento de autoevaluación por empleado.</p></div><span class="small-badge">@AeExpected personas</span></div>
        <div class="table-scroll"><table>
                    <thead><tr> <th>Empleado</th><th>Área</th><th>Cumplimiento</th></tr></thead>
                        <tbody>
                            @foreach (var p in AeTabla)
                            {
                                <tr>
                                    <td>@AeNombre(p)</td>
                                    <td>@AeArea(p)</td>
                                    <td>@AeCump(p).ToString("0.#")%</td>
                                </tr>
                            }
                        </tbody>
                </table>
            </div>
        </div>
        </section>

    <!-- 05 SERVICIO -->
    <section class="dash-section">
        <div class="section-heading">
            <div class="section-number">05</div>
            <div><h2>🤝 Bloque de Servicio al cliente</h2><p>Horas planeadas contra reales, servicios, actividades y reprogramaciones.</p></div>
        </div>

        <div class="metric-grid four">
            <div class="metric-card"><div class="metric-label">🕒 Horas planeadas</div><div class="metric-value">@ClientPlanned h</div></div>
            <div class="metric-card"><div class="metric-label">⏱️ Horas reales</div><div class="metric-value">@ClientReal h</div></div>
            <div class="metric-card"><div class="metric-label">↕ Desviación</div><div class="metric-value">@(ClientVariance >= 0 ? "+" : "")@ClientVariance%</div><div class="metric-detail orange">real vs planeado</div></div>
            <div class="metric-card"><div class="metric-label">🔁 Reprogramaciones</div><div class="metric-value">@ClientRescheduled</div><div class="metric-detail red">actividades movidas</div></div>
        </div>

        <div class="two-columns client-columns">
            <div class="dash-card chart-card">
                <div class="chart-title"><span>📊</span><div><h3>Planeado vs real por servicio</h3><p>Detecta servicios que consumen más tiempo del previsto.</p></div></div>
                @foreach (var service in ClientServices)
                {
                    var planned = SelectedPerson != null ? (int)Math.Round(service.Planned * (double)TotalClientActivities / DashClientActivities) : Active.Area != "" ? (int)Math.Round(service.Planned * ScopeFactor) : service.Planned;
                    var real = SelectedPerson != null ? (int)Math.Round(service.Real * (double)TotalClientActivities / DashClientActivities) : Active.Area != "" ? (int)Math.Round(service.Real * ScopeFactor) : service.Real;
                    <div class="service-row">
                        <div class="service-name">@service.Name</div>
                        <div class="service-bars">
                            <div class="service-bar planned" style="@WidthStyle(planned, 350)">P @planned</div>
                            <div class="service-bar real" style="@WidthStyle(real, 350)">R @real</div>
                        </div>
                    </div>
                }
                <div class="service-legend"><span><i class="legend-dot planned-bg"></i>Planeado</span><span><i class="legend-dot real-bg"></i>Real</span></div>
            </div>

            <div class="dash-card chart-card">
                <div class="chart-title"><span>🏷️</span><div><h3>Empresas con mayor carga</h3><p>Horas reales registradas.</p></div></div>
                @foreach (var company in ClientCompanies)
                {
                    var hours = SelectedPerson != null ? (int)Math.Round(company.Hours * (double)TotalClientActivities / DashClientActivities) : Active.Area != "" ? (int)Math.Round(company.Hours * ScopeFactor) : company.Hours;
                    <div class="company-row">
                        <div class="company-head"><span>@company.Name</span><b>@hours h</b></div>
                        <div class="progress"><div class="progress-fill" style="@BarStyle(hours / 148.0 * 100, company == ClientCompanies.First() ? "#7f83d9" : "#b8bcc8")"></div></div>
                    </div>
                }
            </div>
        </div>

        <div class="dash-card table-card table-gap">
            <div class="table-header"><div><h3>🏢 Comparación por área</h3><p>Horas planeadas, reales y reprogramaciones.</p></div></div>
            <div class="table-scroll">
                <table>
                    <thead><tr><th>Área</th><th>Planeadas</th><th>Reales</th><th>Desviación</th><th>Reprogramadas</th></tr></thead>
                    <tbody>
                        @foreach (var a in FilteredClientAreas)
                        {
                            <tr><td>@a.Name</td><td>@a.Planned h</td><td>@a.Real h</td><td>@a.Variance h</td><td>@a.Rescheduled</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="dash-card table-card table-gap">
            <div class="table-header"><div><h3>👤 Detalle individual</h3><p>Carga de servicio registrada por empleado.</p></div></div>
            <div class="table-scroll">
                <table>
                    <thead><tr><th>Empleado</th><th>Área</th><th>Horas</th><th>Actividades</th><th>Índice de agenda</th></tr></thead>
                    <tbody>
                        @foreach (var p in PeopleRows)
                        {
                            //<tr><td>@p.Name</td><td>@AreaShort(p.AreaId)</td><td>@Math.Round(p.ClientActivities * 5.9) h</td><td>@p.ClientActivities</td><td>@p.Index%</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>
</div>

