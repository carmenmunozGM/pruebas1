    private PersonModel? SelectedPerson => People.FirstOrDefault(p => p.Name == Active.Person);

    private IEnumerable<PersonModel> ScopedPeople =>
        SelectedPerson != null
            ? new[] { SelectedPerson }
            : People.Where(p => string.IsNullOrWhiteSpace(Active.Area) || p.AreaId == Active.Area);

    private IEnumerable<PersonModel> PeopleRows => ScopedPeople;

    private int TotalPeople => ScopedPeople.Count();
    private int ActiveUsers => ScopedPeople.Count(p => p.Active);
    private int Adoption => TotalPeople == 0 ? 0 : (int)Math.Round(ActiveUsers * 100.0 / TotalPeople);
    private int TotalAgenda => ScopedPeople.Sum(p => p.Agenda);
    private int TotalClientActivities => ScopedPeople.Sum(p => p.ClientActivities);
    private int DashClientActivities => 214;
    private double ScopeFactor => People.Count == 0 ? 0 : TotalPeople / (double)People.Count;

    private int TaskTotal => SelectedPerson != null ? SelectedPerson.Tasks : Active.Area != "" ? Scoped(486) : 486;
    private int TaskPending => SelectedPerson != null ? Math.Max(0,(int)Math.Round(SelectedPerson.Tasks*.24)) : Active.Area != "" ? Scoped(112) : 112;
    private int TaskOverdue => SelectedPerson != null ? Math.Max(0,(int)Math.Round(SelectedPerson.Tasks*.08)) : Active.Area != "" ? Scoped(43) : 43;
    private int TaskOnTime => SelectedPerson != null ? Math.Max(0,SelectedPerson.Tasks-TaskPending-TaskOverdue) : Active.Area != "" ? Scoped(331) : 331;

    private int TaskPendingPct => Percent(TaskPending,TaskTotal);
    private int TaskOverduePct => Percent(TaskOverdue,TaskTotal);
    private int TaskOnTimePct => Percent(TaskOnTime,TaskTotal);

    private int OrderTotal => SelectedPerson != null ? Math.Max(1,(int)Math.Round(SelectedPerson.ClientActivities*.55)) : Active.Area != "" ? Scoped(218) : 218;
    private int OrderToday => SelectedPerson != null ? (int)Math.Round(OrderTotal*.08) : Active.Area != "" ? Scoped(18) : 18;
    private int OrderUpcoming => SelectedPerson != null ? (int)Math.Round(OrderTotal*.32) : Active.Area != "" ? Scoped(71) : 71;
    private int OrderOverdue => SelectedPerson != null ? (int)Math.Round(OrderTotal*.11) : Active.Area != "" ? Scoped(24) : 24;
    private int OrderCompleted => Math.Max(0,OrderTotal-OrderToday-OrderUpcoming-OrderOverdue);

    private int AeExpected => TotalPeople;
    private int AeRegistered => ScopedPeople.Count(p => p.Active);
    private int AeNotRegistered => Math.Max(0,AeExpected-AeRegistered);
    private int AeCompliance => TotalPeople == 0 ? 0 : (int)Math.Round(ScopedPeople.Average(p => p.Index));
    private int AeCoverage => AeExpected == 0 ? 0 : (int)Math.Round(AeRegistered*100.0/AeExpected);

    private int ClientPlanned => SelectedPerson != null ? (int)Math.Round(SelectedPerson.ClientActivities*5.4) : Active.Area != "" ? Scoped(1248) : 1248;
    private int ClientReal => SelectedPerson != null ? (int)Math.Round(SelectedPerson.ClientActivities*5.9) : Active.Area != "" ? Scoped(1376) : 1376;
    private int ClientVariance => ClientPlanned == 0 ? 0 : (int)Math.Round((ClientReal-ClientPlanned)*100.0/ClientPlanned);
    private int ClientRescheduled => SelectedPerson != null ? (int)Math.Round(SelectedPerson.ClientActivities*.18) : Active.Area != "" ? Scoped(86) : 86;

    private IEnumerable<AreaRow> AreaRows =>
