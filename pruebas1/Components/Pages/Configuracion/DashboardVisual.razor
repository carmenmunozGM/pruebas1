@page "/dashboard"

<div class="dashboard-shell">
    <div class="dashboard-content">

                <div class="dashboard-heading">
                    <div>
                        <div class="eyebrow">AGENDA · DASHBOARD</div>
                        <h1>Vista general del despacho</h1>
                        <p>Adopción, tareas, órdenes, autoevaluación y servicio al cliente en una sola lectura.</p>
                    </div>
                    <div class="period-chip">📅 @PeriodLabel</div>
                </div>

                <section class="dash-card filters-card">
                    <div class="filters-title">
                        <span>⚙️</span>
                        <div>
                            <div class="section-card-title">Filtros de consulta</div>
                            <div class="muted">Selecciona el alcance y después aplica para actualizar el dashboard.</div>
                        </div>
                    </div>

                    <div class="filters-grid">
                        <label>
                            AÑO
                            <select @bind="Year">
                                <option value="2026">2026</option>
                            </select>
                        </label>

                        <label>
                            MES
                            <select @bind="Month">
                                @foreach (var m in Months)
                                {
                                    <option value="@m.Value">@m.Label</option>
                                }
                            </select>
                        </label>

                        <label>
                            ÁREA
                            <select @bind="AreaFilter" @bind:after="AreaChanged">
                                <option value="">Todo el despacho</option>
                                @foreach (var area in Areas)
                                {
                                    <option value="@area.Id">@area.Name</option>
                                }
                            </select>
                        </label>

                        <label>
                            PERSONA
                            <select @bind="PersonFilter">
                                <option value="">Todas las personas</option>
                                @foreach (var person in People.Where(p => string.IsNullOrWhiteSpace(AreaFilter) || p.AreaId == AreaFilter))
                                {
                                    <option value="@person.Name">@person.Name</option>
                                }
                            </select>
                        </label>

                        <button class="btn-primary" @onclick="ApplyFilters">✓ Aplicar filtros</button>
                        <button class="btn-secondary" @onclick="ClearFilters">↺ Limpiar</button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Active.Area) || !string.IsNullOrWhiteSpace(Active.Person))
                    {
                        <div class="filter-summary">
                            🔎 Vista filtrada · @(string.IsNullOrWhiteSpace(Active.Person)
                                ? Areas.FirstOrDefault(a => a.Id == Active.Area)?.Name
                                : Active.Person)
                        </div>
                    }
                </section>

                <!-- 01 ADOPCIÓN -->
                <section class="dash-section">
                    <div class="section-heading">
                        <div class="section-number">01</div>
                        <div>
                            <h2>👥 Adopción de Agenda</h2>
                            <p>Primero medimos si la herramienta realmente se usa. Después bajamos a área y persona.</p>
                        </div>
                    </div>

                    <div class="metric-grid adoption-grid">
                        <div class="dash-card adoption-card">
                            <div class="donut" style="@DonutStyle(Adoption, "#6366c1")">
                                <div class="donut-inner">@Adoption%</div>
                            </div>
                            <div>
                                <div class="metric-label">Adopción</div>
                                <div class="metric-big">@ActiveUsers de @TotalPeople</div>
                                <div class="metric-detail purple">empleados con actividad</div>
                            </div>
                        </div>

                        <div class="metric-card">
                            <div class="metric-label">🟢 Con actividad</div>
                            <div class="metric-value">@ActiveUsers</div>
                            <div class="metric-detail green">usan Agenda</div>
                        </div>

                        <div class="metric-card">
                            <div class="metric-label">⚪ Sin actividad</div>
                            <div class="metric-value">@(TotalPeople - ActiveUsers)</div>
                            <div class="metric-detail red">sin registro</div>
                        </div>

                        <div class="metric-card">
                            <div class="metric-label">📆 Actividad registrada</div>
                            <div class="metric-value">@TotalAgenda</div>
                            <div class="metric-detail purple">eventos / agenda</div>
                        </div>
                    </div>

                    <div class="two-columns">
                        <div class="dash-card chart-card">
                            <div class="chart-title">
                                <span>📊</span>
                                <div><h3>Adopción por área</h3><p>Porcentaje de personas con actividad.</p></div>
                            </div>

                            <div class="horizontal-bars">
                                @foreach (var area in AreaRows)
                                {
                                    <div class="hbar-row">
                                        <span>@area.Short</span>
                                        <div class="bar-track">
                                            <div class="bar-fill" style="@BarStyle(area.Adoption, area.Color)"></div>
                                        </div>
                                        <b>@area.Adoption%</b>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="dash-card chart-card">
                            <div class="chart-title">
                                <span>📈</span>
                                <div><h3>Tendencia de uso</h3><p>Evolución mensual de adopción.</p></div>
                            </div>

                            <div class="trend-chart">
                                @foreach (var item in AdoptionTrend.Select((value, index) => new { value, index }))
                                {
                                    <div class="trend-point" style="@TrendPointStyle(item.value)">
                                        <span>@item.value%</span>
                                    </div>
                                }
                            </div>
                            <div class="trend-labels">
                                @foreach (var m in DashMonths)
                                {
                                    <span>@m</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="dash-card table-card">
                        <div class="table-header">
                            <div><h3>🧑‍💼 Uso individual</h3><p>Quién entra a la Agenda y quién no.</p></div>
                            <span class="small-badge">@TotalPeople personas</span>
                        </div>
                        <div class="table-scroll">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Empleado</th><th>Área</th><th>Agenda</th><th>Tareas</th><th>Actividades cliente</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in PeopleRows)
                                    {
                                        <tr>
                                            <td>@p.Name</td>
                                            <td>@AreaShort(p.AreaId)</td>
                                            <td>@p.Agenda</td>
                                            <td>@p.Tasks</td>
                                            <td>@p.ClientActivities</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>

                <!-- 02 TAREAS -->
                <section class="dash-section">
                    <div class="section-heading">
                        <div class="section-number">02</div>
                        <div><h2>📝 Tareas</h2><p>Carga, cumplimiento de fecha y retraso. La lectura sigue despacho → área → empleado.</p></div>
                    </div>

                    <div class="metric-grid four">
                        <div class="metric-card"><div class="metric-label">📋 Registradas</div><div class="metric-value">@TaskTotal</div></div>
                        <div class="metric-card"><div class="metric-label">⏳ Pendientes</div><div class="metric-value">@TaskPending</div><div class="metric-detail gray">@TaskPendingPct% del total</div></div>
                        <div class="metric-card"><div class="metric-label">✓ En fecha</div><div class="metric-value">@TaskOnTime</div><div class="metric-detail green">@TaskOnTimePct% del total</div></div>
                        <div class="metric-card"><div class="metric-label">⚠ Vencidas</div><div class="metric-value">@TaskOverdue</div><div class="metric-detail red">@TaskOverduePct% del total</div></div>
                    </div>

                    <div class="two-columns task-columns">
                        <div class="dash-card chart-card">
                            <div class="chart-title"><span>🍩</span><div><h3>Estado de tareas</h3><p>Distribución del trabajo.</p></div></div>
                            <div class="donut-panel">
                                <div class="donut task-donut" style="@TaskDonutStyle()"><div class="donut-inner">@TaskTotal</div></div>
                                <div class="legend-list">
                                    <div><span><i class="legend-dot purple-bg"></i>En fecha</span><b>@TaskOnTime</b></div>
                                    <div><span><i class="legend-dot orange-bg"></i>Pendientes</span><b>@TaskPending</b></div>
                                    <div><span><i class="legend-dot red-bg"></i>Vencidas</span><b>@TaskOverdue</b></div>
                                </div>
                            </div>
                        </div>

                        <div class="dash-card chart-card">
                            <div class="chart-title"><span>⏱️</span><div><h3>Retraso sobre fecha comprometida</h3><p>Cuántos días después se terminó o sigue abierta.</p></div></div>
                            @foreach (var bucket in DelayBuckets)
                            {
                                <div class="delay-item">
                                    <div class="delay-head"><span>@bucket.Label</span><b>@bucket.Value</b></div>
                                    <div class="progress"><div class="progress-fill" style="@BarStyle(TaskTotal == 0 ? 0 : bucket.Value * 100.0 / TaskTotal, bucket.Color)"></div></div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="dash-card table-card">
                        <div class="table-header"><div><h3>🏢 Comparación por área</h3><p>Detalle de volumen y cumplimiento.</p></div></div>
                        <div class="table-scroll">
                            <table>
                                <thead><tr><th>Área</th><th>Registradas</th><th>En fecha</th><th>Pendientes</th><th>Vencidas</th><th>Cumplimiento</th></tr></thead>
                                <tbody>
                                    @foreach (var a in FilteredTaskAreas)
                                    {
                                        <tr><td>@a.Name</td><td>@a.Total</td><td>@a.OnTime</td><td>@a.Pending</td><td>@a.Overdue</td><td><span class="pill pill-purple">@Percent(a.OnTime,a.Total)%</span></td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="dash-card table-card table-gap">
                        <div class="table-header"><div><h3>👤 Detalle individual</h3><p>Tareas registradas, cumplimiento y vencimientos por empleado.</p></div><span class="small-badge">@PeopleRows.Count() personas</span></div>
                        <div class="table-scroll">
                            <table>
                                <thead><tr><th>Empleado</th><th>Área</th><th>Registradas</th><th>En fecha</th><th>Pendientes</th><th>Vencidas</th><th>Cumplimiento</th></tr></thead>
                                <tbody>
                                    @foreach (var p in PeopleRows)
                                    {
                                        var onTime = Math.Max(0, Math.Min(p.Tasks, (int)Math.Round(p.Tasks * p.Index / 100.0)));
                                        var pending = Math.Max(0, (int)Math.Round(p.Tasks * (1 - p.Index / 100.0) * .55));
                                        var overdue = Math.Max(0, p.Tasks - onTime - pending);
                                        <tr><td>@p.Name</td><td>@AreaShort(p.AreaId)</td><td>@p.Tasks</td><td>@onTime</td><td>@pending</td><td>@overdue</td><td><span class="pill pill-purple">@Percent(onTime,p.Tasks)%</span></td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>

                <!-- 03 ORDENES -->
                <section class="dash-section">
                    <div class="section-heading">
                        <div class="section-number">03</div>
                        <div><h2>📑 Órdenes de trabajo</h2><p>No solo cuántas están vencidas: antigüedad, acumulación, recuperación y detalle individual.</p></div>
                    </div>

                    <div class="metric-grid five">
                        <div class="metric-card"><div class="metric-label">📦 Total</div><div class="metric-value">@OrderTotal</div></div>
                        <div class="metric-card"><div class="metric-label">🔴 Vencidas</div><div class="metric-value">@OrderOverdue</div><div class="metric-detail red">requieren seguimiento</div></div>
                        <div class="metric-card"><div class="metric-label">🟠 Próximas</div><div class="metric-value">@OrderUpcoming</div><div class="metric-detail orange">por vencer</div></div>
                        <div class="metric-card"><div class="metric-label">📅 Hoy</div><div class="metric-value">@OrderToday</div><div class="metric-detail orange">atención inmediata</div></div>
                        <div class="metric-card"><div class="metric-label">✓ Atendidas</div><div class="metric-value">@OrderCompleted</div><div class="metric-detail green">cerradas</div></div>
                    </div>

                    <div class="two-columns">
                        <div class="dash-card chart-card">
                            <div class="chart-title"><span>⏳</span><div><h3>Días de las órdenes vencidas</h3><p>Distribución de antigüedad.</p></div></div>
                            <div class="column-chart">
                                @foreach (var item in Aging)
                                {
                                    var value = ScopedOrderValue(item.Value);
                                    <div class="column-item">
                                        <div class="column-value">@value</div>
                                        <div class="column-bar-area"><div class="column-bar" style="@ColumnStyle(value)"></div></div>
                                        <span>@item.Label</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="dash-card chart-card">
                            <div class="chart-title"><span>📈</span><div><h3>Histórico por mes / vencidas</h3><p>Órdenes vencidas acumuladas por periodo.</p></div></div>
                            <div class="backlog-chart">
                                @foreach (var item in Backlog)
                                {
                                    var value = ScopedOrderValue(item.Value);
                                    <div class="backlog-column">
                                        <b>@value</b>
                                        <div class="backlog-bar" style="@HeightStyle(value,44)"></div>
                                        <span>@item.Month</span>
                                    </div>
                                }
                            </div>
                            <div class="last-period"><span>Último periodo</span><b>@ScopedOrderValue(44) vencidas</b></div>
                        </div>
                    </div>

                    <div class="dash-card table-card table-gap">
                        <div class="table-header"><div><h3>🏢 Comparación por área</h3><p>Volumen, vencimientos y carga histórica por área.</p></div></div>
                        <div class="table-scroll">
                            <table>
                                <thead><tr><th>Área</th><th>Total</th><th>Atendidas</th><th>Próximas</th><th>Vencidas</th><th>Hoy</th><th>Vencidas +90d</th></tr></thead>
                                <tbody>
                                    @foreach (var a in FilteredOrderAreas)
                                    {
                                        <tr><td>@a.Name</td><td>@a.Total</td><td>@a.Attended</td><td>@a.Upcoming</td><td>@a.Overdue</td><td>@a.Today</td><td>@(string.IsNullOrWhiteSpace(Active.Area) ? 1 : Math.Max(0,(int)Math.Round(3 * ScopeFactor)))</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="dash-card table-card table-gap">
                        <div class="table-header"><div><h3>👤 Análisis individual</h3><p>Vencidas, atraso promedio, máxima antigüedad y recuperación por empleado.</p></div><span class="small-badge">@PeopleRows.Count() personas</span></div>
                        <div class="table-scroll">
                            <table>
                                <thead><tr><th>Empleado</th><th>Área</th><th>Vencidas</th><th>Atraso promedio</th><th>Máximo atraso</th><th>Recuperadas</th></tr></thead>
                                <tbody>
                                    @foreach (var p in FilteredOrderPeople)
                                    {
                                        <tr><td>@p.Name</td><td>@p.Area</td><td>@p.Overdue</td><td>@p.Avg días</td><td><span class="pill" style="color:@OldColor(p.Max);background:@OldBackground(p.Max)">@p.Max días</span></td><td>@p.Recovered</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>

                <!-- 04 AUTOEVALUACION -->
                <section class="dash-section">
                    <div class="section-heading">
                        <div class="section-number">04</div>
                        <div><h2>📋 Autoevaluación</h2><p>Separamos tres cosas: cobertura del registro, cumplimiento de actividades y consistencia entre periodos.</p></div>
                    </div>

                    <div class="metric-grid ae-grid">
                        <div class="dash-card adoption-card">
                            <div class="donut" style="@DonutStyle(AeCoverage, "#7f83d9")"><div class="donut-inner">@AeCoverage%</div></div>
                            <div><div class="metric-label">Registraron</div><div class="metric-big">@AeRegistered/@AeExpected</div><div class="metric-detail purple">personas con registro</div></div>
                        </div>
                        <div class="metric-card"><div class="metric-label">✓ Registraron</div><div class="metric-value">@AeRegistered</div></div>
                        <div class="metric-card"><div class="metric-label">⚪ No registraron</div><div class="metric-value">@AeNotRegistered</div></div>
                        <div class="metric-card"><div class="metric-label">📈 Cumplimiento</div><div class="metric-value">@AeCompliance%</div><div class="metric-detail purple">actividades declaradas</div></div>
                    </div>

                    <div class="dash-card table-card">
                        <div class="table-header"><div><h3>🏢 Autoevaluación por área</h3><p>Personas registradas y nivel de cumplimiento.</p></div></div>
                        <div class="table-scroll">
                            <table>
                                <thead><tr><th>Área</th><th>Personas</th><th>Registraron</th><th>Cobertura</th><th>Cumplimiento</th></tr></thead>
                                <tbody>
                                    @foreach (var a in AreaRows)
                                    {
                                        var average = a.People == 0 ? 0 : (int)Math.Round(People.Where(p => p.AreaId == a.Id).Select(p => p.Index).DefaultIfEmpty().Average());
                                        <tr><td>@a.Short</td><td>@a.People</td><td>@a.Active</td><td>@Percent(a.Active,a.People)%</td><td>@average%</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="dash-card table-card table-gap">
                        <div class="table-header"><div><h3>👤 Detalle individual</h3><p>Registro y cumplimiento de autoevaluación por empleado.</p></div><span class="small-badge">@PeopleRows.Count() personas</span></div>
                        <div class="table-scroll">
                            <table>
                                <thead><tr><th>Empleado</th><th>Área</th><th>Registro</th><th>Esperadas</th><th>Realizadas</th><th>Cumplimiento</th></tr></thead>
                                <tbody>
                                    @foreach (var p in PeopleRows)
                                    {
                                        var realized = (int)Math.Round(10 * p.Index / 100.0);
                                        <tr><td>@p.Name</td><td>@AreaShort(p.AreaId)</td><td><span class="pill @(p.Active ? "pill-green" : "pill-red")">@(p.Active ? "Registrada" : "Pendiente")</span></td><td>10</td><td>@realized</td><td>@p.Index%</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>

                <!-- 05 SERVICIO -->
                <section class="dash-section">
                    <div class="section-heading">
                        <div class="section-number">05</div>
                        <div><h2>🤝 Servicio al cliente</h2><p>Horas planeadas contra reales, servicios, actividades y reprogramaciones.</p></div>
                    </div>

                    <div class="metric-grid four">
                        <div class="metric-card"><div class="metric-label">🕒 Horas planeadas</div><div class="metric-value">@ClientPlanned h</div></div>
                        <div class="metric-card"><div class="metric-label">⏱️ Horas reales</div><div class="metric-value">@ClientReal h</div></div>
                        <div class="metric-card"><div class="metric-label">↕ Desviación</div><div class="metric-value">@(ClientVariance >= 0 ? "+" : "")@ClientVariance%</div><div class="metric-detail orange">real vs planeado</div></div>
                        <div class="metric-card"><div class="metric-label">🔁 Reprogramaciones</div><div class="metric-value">@ClientRescheduled</div><div class="metric-detail red">actividades movidas</div></div>
                    </div>

                    <div class="two-columns client-columns">
                        <div class="dash-card chart-card">
                            <div class="chart-title"><span>📊</span><div><h3>Planeado vs real por servicio</h3><p>Detecta servicios que consumen más tiempo del previsto.</p></div></div>
                            @foreach (var service in ClientServices)
                            {
                                var planned = SelectedPerson != null ? (int)Math.Round(service.Planned * (double)TotalClientActivities / DashClientActivities) : Active.Area != "" ? (int)Math.Round(service.Planned * ScopeFactor) : service.Planned;
                                var real = SelectedPerson != null ? (int)Math.Round(service.Real * (double)TotalClientActivities / DashClientActivities) : Active.Area != "" ? (int)Math.Round(service.Real * ScopeFactor) : service.Real;
                                <div class="service-row">
                                    <div class="service-name">@service.Name</div>
                                    <div class="service-bars">
                                        <div class="service-bar planned" style="@WidthStyle(planned,350)">P @planned</div>
                                        <div class="service-bar real" style="@WidthStyle(real,350)">R @real</div>
                                    </div>
                                </div>
                            }
                            <div class="service-legend"><span><i class="legend-dot planned-bg"></i>Planeado</span><span><i class="legend-dot real-bg"></i>Real</span></div>
                        </div>

                        <div class="dash-card chart-card">
                            <div class="chart-title"><span>🏷️</span><div><h3>Empresas con mayor carga</h3><p>Horas reales registradas.</p></div></div>
                            @foreach (var company in ClientCompanies)
                            {
                                var hours = SelectedPerson != null ? (int)Math.Round(company.Hours * (double)TotalClientActivities / DashClientActivities) : Active.Area != "" ? (int)Math.Round(company.Hours * ScopeFactor) : company.Hours;
                                <div class="company-row">
                                    <div class="company-head"><span>@company.Name</span><b>@hours h</b></div>
                                    <div class="progress"><div class="progress-fill" style="@BarStyle(hours / 148.0 * 100, company == ClientCompanies.First() ? "#7f83d9" : "#b8bcc8")"></div></div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="dash-card table-card table-gap">
                        <div class="table-header"><div><h3>🏢 Comparación por área</h3><p>Horas planeadas, reales y reprogramaciones.</p></div></div>
                        <div class="table-scroll">
                            <table>
                                <thead><tr><th>Área</th><th>Planeadas</th><th>Reales</th><th>Desviación</th><th>Reprogramadas</th></tr></thead>
                                <tbody>
                                    @foreach (var a in FilteredClientAreas)
                                    {
                                        <tr><td>@a.Name</td><td>@a.Planned h</td><td>@a.Real h</td><td>@a.Variance h</td><td>@a.Rescheduled</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="dash-card table-card table-gap">
                        <div class="table-header"><div><h3>👤 Detalle individual</h3><p>Carga de servicio registrada por empleado.</p></div></div>
                        <div class="table-scroll">
                            <table>
                                <thead><tr><th>Empleado</th><th>Área</th><th>Horas</th><th>Actividades</th><th>Índice de agenda</th></tr></thead>
                                <tbody>
                                    @foreach (var p in PeopleRows)
                                    {
                                        <tr><td>@p.Name</td><td>@AreaShort(p.AreaId)</td><td>@Math.Round(p.ClientActivities * 5.9) h</td><td>@p.ClientActivities</td><td>@p.Index%</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>
            </div>
    </div>

@code {
    private string Year { get; set; } = "2026";
    private string Month { get; set; } = "08";
    private string AreaFilter { get; set; } = "";
    private string PersonFilter { get; set; } = "";

    private FilterState Active { get; set; } = new("2026", "08", "", "");

    private readonly List<AreaModel> Areas =
    [
        new("CON","Asesoría Contable","Contable","#2563eb"),
        new("LEG","Asesoría Legal","Legal","#7c3aed"),
        new("AUD","Auditoría","Auditoría","#0891b2"),
        new("TI","Tecnologías de Información","TI","#f59e0b"),
        new("FIS","Asesoría Fiscal","Fiscal","#0f766e"),
