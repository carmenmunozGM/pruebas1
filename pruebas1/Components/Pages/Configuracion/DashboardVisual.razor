    private async Task CargarTareasPeriodoAsync()
    {
        ErrorTareas = "";

        try
        {
            int anio = int.Parse(Active.Year);

            int mesDesde = string.IsNullOrWhiteSpace(Active.MonthFrom)
                ? 1
                : int.Parse(Active.MonthFrom);

            int mesHasta = string.IsNullOrWhiteSpace(Active.MonthTo)
                ? 12
                : int.Parse(Active.MonthTo);

            if (mesDesde < 1 || mesDesde > 12 ||
                mesHasta < 1 || mesHasta > 12 ||
                mesDesde > mesHasta)
            {
                ErrorTareas = "Selecciona un rango de meses válido.";
                return;
            }

            var desde = new DateTime(anio, mesDesde, 1);

            var hasta = new DateTime(
                anio,
                mesHasta,
                DateTime.DaysInMonth(anio, mesHasta));

            var resultado =
                await TareasDuracionService.ObtenerDuracionTareasAsync(
                    desde,
                    hasta);

            TaskDuracionList = resultado?.ToList() ?? new();

            StateHasChanged();
        }
        catch (Exception ex)
        {
            ErrorTareas = $"No se pudieron cargar las tareas: {ex.Message}";
        }
    }

    private async Task CargarAdopcionAsync(
        string year,
        string monthFrom,
        string monthTo,
        string areaFilter,
        string personFilter)
    {
        CargandoAdopcion = true;
        ErrorAdopcion = "";

        try
        {
            int anio = int.Parse(year);
            int mesDesde = string.IsNullOrWhiteSpace(monthFrom)
                ? 1
                : int.Parse(monthFrom);
            int mesHasta = string.IsNullOrWhiteSpace(monthTo)
                ? 12
                : int.Parse(monthTo);

            if (mesDesde < 1 || mesHasta > 12 || mesDesde > mesHasta)
            {
                ErrorAdopcion = "Selecciona un rango de meses válido.";
                return;
            }

            string? nombreArea = null;

            if (!string.IsNullOrWhiteSpace(areaFilter))
            {
                nombreArea = AreasFiltro.FirstOrDefault(
                    a => a.Clave.ToString() == areaFilter)?.Area;
            }

            AdopcionDatos = await AdopcionAgendaService.ObtenerAdopcionAsync(
                anio,
                mesDesde,
                mesHasta,
                nombreArea,
                string.IsNullOrWhiteSpace(personFilter) ? null : personFilter);
        }
        catch (Exception)
        {
            ErrorAdopcion = "No se pudieron cargar los datos de Adopción de Agenda.";
        }
        finally
        {
            CargandoAdopcion = false;
        }
    }
