@using pruebas1.Components.DTOs
@using pruebas1.Servicios
@using static System.Net.WebRequestMethods
@inject AreasService AreasService
@inject PerfilesService PerfilesService
@inject ArchivoPermanenteService ArchivoPermanenteService
@inject HttpClient Http
@inject HorariosService HorariosService

<div class="perfiles-section">
    <div class="section-header">
        <h2>Perfiles y Permisos</h2>
        <p>Gestiona los roles de los empleados y accesos al Archivo Permanente</p>
    </div>

    <div class="search-section">
        <div class="search-bar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.35-4.35"></path>
            </svg>
            <input type="text"
                   @bind="searchName"
                   @bind:event="oninput"
                   placeholder="Buscar por nombre o puesto..." />
        </div>

        @if (!isModoArchivo)
        {
            <select class="area-filter" @bind="selectedArea">
                <option value="">Todas las áreas</option>
                @foreach (var area in areaList)
                {
                    <option value="@area.Area">@area.Area</option>
                }
            </select>
        }

        <button class="save-button" style="margin-left: 10px; background-color: @(isModoArchivo ? "#2da549" : "#4543ec");"
                @onclick="ToggleModo">
            <span>@(isModoArchivo ? "Perfil por persona" : "Permisos Archivo Permanente")</span>
        </button>
    </div>

    <div class="perfiles-container">
        @if (!isModoArchivo)
        {
            <!-- TABLA DE EMPLEADOS (PERFILES) -->
            <table class="perfiles-table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Puesto</th>
                        <th>Tipo de Usuario</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (employee, index) in filteredEmployees.Select((emp, idx) => (emp, idx)))
                    {
                        <tr>
                            <td>
                                <div class="employee-info">
                                    <div class="employee-avatar" style="background: @GetAvatarColor(index)">
                                        @GetInitials(employee.Nombre)
                                    </div>
                                    <span>@employee.Nombre</span>
                                </div>
                            </td>
                            <td>@employee.Puesto</td>
                            <td>
                                <select class="user-type-select" @bind="employee.PerfilId">
                                    @foreach (var perfil in perfilesList)
                                    {
                                        <option value="@perfil.Id">@perfil.Descripcion</option>
                                    }
                                </select>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <!-- TABLA DE PUESTOS (ARCHIVO PERMANENTE) -->
            <table class="perfiles-table">
                <thead>
                    <tr>
                        <th>Puesto</th>
                        <th style="text-align: center;">Visualizar</th>
                        <th style="text-align: center;">Cargar</th>
                        <th style="text-align: center;">Descargar</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var puesto in filteredPuestos)
                    {
                        <tr>
                            <td style="font-weight: 500;">@puesto.NombrePuesto</td>
                            <td style="text-align: center;">
                                <input type="checkbox" @bind="puesto.Visualizar" style="transform: scale(1.5);" />
                            </td>
                            <td style="text-align: center;">
                                <input type="checkbox" @bind="puesto.Cargar" style="transform: scale(1.5);" />
                            </td>
                            <td style="text-align: center;">
                                <input type="checkbox" @bind="puesto.Descargar" style="transform: scale(1.5);" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <div class="save-section">
            <button class="save-button" @onclick="HandleSave">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                    <polyline points="17 21 17 13 7 13 7 21"></polyline>
                    <polyline points="7 3 7 8 15 8"></polyline>
                </svg>
                <span>Guardar Cambios @(isModoArchivo ? "de Archivo" : "de Perfiles")</span>
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="message-toast">
            @message
        </div>
    }
</div>

@code {
    string? selectedArea;
    List<AreaDTO> areaList = new();
    List<PerfilesDTO> perfilesList = new();

    // Listas separadas para cada vista
    List<EmployeeInfo> employees = new();
    List<PuestoInfo> puestos = new();

    private string message = "";
    private string searchName = "";
    string? selectedPerfil;

    HoraSistemaDTO? alertaHora;
    bool mostrarAlerta = false;

    bool isModoArchivo = false;

    protected override async Task OnInitializedAsync()
    {
        areaList = await AreasService.GetAreas();
        perfilesList = await PerfilesService.GetPerfiles();
        await CargarDatos();
    }

    private void ToggleModo()
    {
        isModoArchivo = !isModoArchivo;
        // Limpiamos los filtros al cambiar de vista
        searchName = "";
        selectedArea = "";
    }

    private async Task<bool> ValidarHora()
    {
        var resultado = await HorariosService.GetHorario();

        if (resultado.Desfase)
        {
            alertaHora = resultado;
            mostrarAlerta = true;
            await InvokeAsync(StateHasChanged);
            return false;
        }

        return true;
    }

    private async Task CargarDatos()
    {
        // 1. Cargar Empleados
        var empleadosDto = await PerfilesService.GetEmpleadosPerfiles();
        employees = empleadosDto
            .OrderBy(e => e.Clave)
            .Select(e =>
            {
                var perfil = perfilesList.FirstOrDefault(p => p.Descripcion == e.Perfil);
                return new EmployeeInfo
                {
                    Clave = e.Clave,
                    Nombre = e.Nombre,
                    Area = e.Area,
                    Puesto = e.Puesto,
                    Perfil = e.Perfil,
                    PerfilId = perfil?.Id ?? 0,
                    PerfilOriginalId = perfil?.Id ?? 0
                };
            })
            .ToList();

        // 2. Cargar Puestos (Permisos de Archivo Permanente)
        var permisosAPGlobales = await ArchivoPermanenteService.ObtenerTodosLosPermisos();

        if (permisosAPGlobales != null)
        {
            puestos = permisosAPGlobales.Select(p => new PuestoInfo
            {
                ClavePuesto = p.ClavePuesto,
                NombrePuesto = p.Puesto, // Ajusta esta propiedad si en tu DTO se llama diferente (ej. Descripcion, Nombre)
                Visualizar = p.Visualizar,
                Cargar = p.Cargar,
                Descargar = p.Descargar,
                VisualizarOriginal = p.Visualizar,
                CargarOriginal = p.Cargar,
                DescargarOriginal = p.Descargar
            }).OrderBy(p => p.NombrePuesto).ToList();
        }
    }

    // CLASES DE ESTADO
    private class EmployeeInfo
    {
        public int Clave { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public string Area { get; set; } = string.Empty;
        public string Puesto { get; set; } = string.Empty;
        public string Perfil { get; set; } = string.Empty;
        public int PerfilId { get; set; }
        public int PerfilOriginalId { get; set; }

        public bool Modificado => PerfilId != PerfilOriginalId;
    };

    private class PuestoInfo
    {
        public string ClavePuesto { get; set; } = string.Empty; // <-- Cambiar de int a string
        public string NombrePuesto { get; set; } = string.Empty;

        public bool Visualizar { get; set; }
        public bool Cargar { get; set; }
        public bool Descargar { get; set; }

        public bool VisualizarOriginal { get; set; }
        public bool CargarOriginal { get; set; }
        public bool DescargarOriginal { get; set; }

        public bool ModificadoAP => Visualizar != VisualizarOriginal ||
                                    Cargar != CargarOriginal ||
                                    Descargar != DescargarOriginal;
    }

    // FILTROS
    private List<EmployeeInfo> filteredEmployees => employees
        .Where(e => string.IsNullOrWhiteSpace(searchName) ||
                    e.Nombre.Contains(searchName, StringComparison.OrdinalIgnoreCase))
        .Where(e => string.IsNullOrEmpty(selectedArea) ||
                    e.Area.Equals(selectedArea, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private List<PuestoInfo> filteredPuestos => puestos
        .Where(p => string.IsNullOrWhiteSpace(searchName) ||
                    p.NombrePuesto.Contains(searchName, StringComparison.OrdinalIgnoreCase))
        .ToList();

    // UTILIDADES VISUALES
    private string[] colors = new string[]
    {
        "#dd0203", "#f78701", "#f7e801",
        "#2da549", "#4543ec", "#85119a"
    };

    private string GetAvatarColor(int index) => colors[index % colors.Length];

    private string GetInitials(string name)
    {
        var parts = name.Split(' ');
        return string.Join("", parts.Select(p => p.Substring(0, 1).ToUpper()));
    }

    // GUARDADO
    private async Task HandleSave()
    {
        if (!await ValidarHora())
            return;

        bool operacionExitosa = false;

        if (!isModoArchivo)
        {
            // Guardar Perfiles (Empleados)
            var cambiosPerfiles = employees
                .Where(e => e.Modificado)
                .Select(e => new EditarPerfilDTO
                {
                    ClavePersonal = e.Clave,
                    IdPerfil = e.PerfilId
                })
                .ToList();

            if (!cambiosPerfiles.Any())
            {
                await MostrarMensajeTemporal("No hay cambios de perfiles");
                return;
            }

            operacionExitosa = await PerfilesService.GuardarPerfiles(cambiosPerfiles);

            if (operacionExitosa)
            {
                foreach (var e in employees.Where(e => e.Modificado))
                    e.PerfilOriginalId = e.PerfilId;
            }
        }
        else
        {
            // Guardar Archivo Permanente (Puestos)
            var cambiosAP = puestos
                .Where(p => p.ModificadoAP)
                .ToList();

            if (!cambiosAP.Any())
            {
                await MostrarMensajeTemporal("No hay cambios en los permisos de archivo");
                return;
            }

            bool todoExitoso = true;

            foreach (var p in cambiosAP)
            {
                var dto = new UpsertPermisosDTO
                {
                    ClavePuesto = p.ClavePuesto,
                    Cargar = p.Cargar,
                    Visualizar = p.Visualizar,
                    Descargar = p.Descargar
                };

                var resultadoItem = await ArchivoPermanenteService.UpsertPermisos(dto);
                if (!resultadoItem)
                {
                    todoExitoso = false;
                    break;
                }
            }

            operacionExitosa = todoExitoso;

            if (operacionExitosa)
            {
                foreach (var p in cambiosAP)
                {
                    p.VisualizarOriginal = p.Visualizar;
                    p.CargarOriginal = p.Cargar;
                    p.DescargarOriginal = p.Descargar;
                }
            }
        }

        if (operacionExitosa)
            await MostrarMensajeTemporal("Cambios guardados correctamente");
        else
            await MostrarMensajeTemporal("Error al guardar");
    }

    private async Task MostrarMensajeTemporal(string msg)
    {
        message = msg;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(2000);
        message = "";
        await InvokeAsync(StateHasChanged);
    }
}

<ReusableHorarioAlert @key="mostrarAlerta"
                      HoraSistema="alertaHora"
                      Visible="mostrarAlerta" />