@page "/archivo-permanente"

@using System.Diagnostics
@using pruebas1.Components.DTOs
@using pruebas1.Servicios
@using Microsoft.AspNetCore.Components.Forms

@inject ArchivoPermanenteService ArchivoService
@inject IJSRuntime JS

<div class="archivo-header">

    <div class="header-info">
        <h2>Archivo Permanente</h2>
        <p>Consulta y administración documental.</p>
    </div>

</div>

<div class="acciones">

    <button class="btn-subir"
            @onclick="AbrirModalSubir">
        📤 Subir archivos
    </button>

    <button class="btn-sincronizar"
            @onclick="ActualizarArchivoPermanente"
            disabled="@Actualizando">

        @if (Actualizando)
        {
            <span>🔄 Actualizando...</span>
        }
        else
        {
            <span>🔄 Actualizar estructura</span>
        }

    </button>

    <input class="input-busqueda"
           @bind="textoBusqueda"
           placeholder="Buscar documento..." />

</div>

<ModalSubirArchivo Visible="@MostrarModalSubir"
                   OnClose="CerrarModalSubir"
                   OnGuardado="RecargarArbol" />

<ModalArchivoPermanente Visible="@MostrarModalOpciones"
                        Nodo="@NodoSeleccionado"
                        OnClose="CerrarModalOpciones"
                        OnEliminado="RecargarArbol" />

<div class="archivo-layout">

    <!-- Árbol -->

    <aside class="tree-panel">

        @if (cargando)
        {
            <div class="loading">
                Cargando estructura...
            </div>
        }
        else if (!Arbol.Any())
        {
            <div class="loading">
                No existen carpetas.
            </div>
        }
        else
        {
            @foreach (var nodo in Arbol)
            {
                <ArchivoPermanenteNodo Nodo="nodo"
                                       OnArchivoSeleccionado="SeleccionarDocumento"
                                       OnAbrirOpciones="AbrirOpcionesNodo" />
            }
        }

    </aside>

    <!-- Visor -->

    <section class="viewer-panel">

        @if (string.IsNullOrWhiteSpace(documentUrl))
        {
            <div class="empty-state">

                <div class="empty-icon">
                    📄
                </div>

                <h3>
                    Ningún documento seleccionado
                </h3>

                <p>
                    Selecciona un documento desde el árbol.
                </p>

            </div>
        }
        else
        {
            <iframe class="pdf-viewer"
                    src="@documentUrl">
            </iframe>
        }

    </section>

</div>

@code
{
    private List<ArchivoPermanenteNodoDTO> Arbol = new();

    private string? documentUrl;

    private string textoBusqueda = "";

    private bool cargando;
    private bool MostrarModalSubir;

    private bool MostrarModalOpciones;

    private ArchivoPermanenteNodoDTO? NodoSeleccionado;

    protected override async Task OnInitializedAsync()
    {
        await CargarArbol();
    }

    private async Task CargarArbol()
    {
        cargando = true;

        Arbol = await ArchivoService.ObtenerArbol();

        Debug.WriteLine($"Nodos: {Arbol.Count}");

        cargando = false;
    }

    private Task AbrirModalSubir()
    {
        MostrarModalSubir = true;
        return Task.CompletedTask;
    }

    private Task CerrarModalSubir()
    {
        MostrarModalSubir = false;
        return Task.CompletedTask;
    }

    private async Task RecargarArbol()
    {
        MostrarModalSubir = false;

        await CargarArbol();
    }

    private async Task SeleccionarDocumento(ArchivoPermanenteNodoDTO nodo)
    {
        if (nodo.EsCarpeta)
            return;

        if (nodo.IdBD == null)
            return;

        if (!nodo.Nombre.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
        {
            documentUrl = null;

            await JS.InvokeVoidAsync(
                "alert",
                "Solo es posible visualizar archivos PDF.");

            return;
        }

        documentUrl =
            $"{ArchivoService.UrlBase}/archivoPermanente/archivo-permanente/visualizar/{nodo.IdBD}";

        StateHasChanged();
    }

    private Task AbrirOpcionesNodo(ArchivoPermanenteNodoDTO nodo)
    {
        NodoSeleccionado = nodo;
        MostrarModalOpciones = true;
        return Task.CompletedTask;
    }

    private Task CerrarModalOpciones()
    {
        MostrarModalOpciones = false;
        NodoSeleccionado = null;
        return Task.CompletedTask;
    }

    private bool Actualizando;

    private async Task ActualizarArchivoPermanente()
    {
        try
        {
            Actualizando = true;
            StateHasChanged();

            bool ok = await ArchivoService.InicializarEstructura();

            if (!ok)
            {
                await JS.InvokeVoidAsync(
                    "alert",
                    "No fue posible inicializar la estructura.");
                return;
            }

            ok = await ArchivoService.SincronizarDesdeSharePoint();

            if (!ok)
            {
                await JS.InvokeVoidAsync(
                    "alert",
                    "No fue posible sincronizar la estructura.");
                return;
            }

            await RecargarArbol();

            await JS.InvokeVoidAsync(
                "alert",
                "Archivo Permanente actualizado correctamente.");
        }
        finally
        {
            Actualizando = false;
            StateHasChanged();
        }
    }
}