@page "/archivo-permanente"

@using System.Diagnostics
@using pruebas1.Components.DTOs
@using pruebas1.Servicios
@using Microsoft.AspNetCore.Components.Forms

@inject ArchivoPermanenteService ArchivoService
@inject IJSRuntime JS

<div class="archivo-header">

    <div class="header-info">
        <h2>Archivo Permanente</h2>
        <p>Consulta y administración documental.</p>
    </div>

</div>

<div class="toolbar">

    <button class="btn-subir"
            @onclick="AbrirModalSubir">
        📤 Subir archivos
    </button>

    <input class="input-busqueda"
           @bind="textoBusqueda"
           placeholder="Buscar documento..." />

    <ModalSubirArchivo Visible="@MostrarModalSubir"
                       OnClose="CerrarModalSubir"
                       OnGuardado="RecargarArbol" />
</div>

<div class="archivo-layout">

    <!-- Árbol -->

    <aside class="tree-panel">

        @if (cargando)
        {
            <div class="loading">
                Cargando estructura...
            </div>
        }
        else if (!Arbol.Any())
        {
            <div class="loading">
                No existen carpetas.
            </div>
        }
        else
        {
            @foreach (var nodo in Arbol)
            {
                <ArchivoPermanenteNodo Nodo="nodo"
                                       OnArchivoSeleccionado="SeleccionarDocumento" />
            }
        }

    </aside>

    <!-- Visor -->

    <section class="viewer-panel">

        @if (string.IsNullOrWhiteSpace(documentUrl))
        {
            <div class="empty-state">

                <div class="empty-icon">
                    📄
                </div>

                <h3>
                    Ningún documento seleccionado
                </h3>

                <p>
                    Selecciona un documento desde el árbol.
                </p>

            </div>
        }
        else
        {
            <iframe class="pdf-viewer"
                    src="@documentUrl">
            </iframe>
        }

    </section>

</div>

@code
{
    private List<ArchivoPermanenteNodoDTO> Arbol = new();

    private string? documentUrl;

    private string textoBusqueda = "";

    private bool cargando;
    private bool MostrarModalSubir;

    protected override async Task OnInitializedAsync()
    {
        await CargarArbol();
    }

    private async Task CargarArbol()
    {
        cargando = true;

        Arbol = await ArchivoService.ObtenerArbol();

        Debug.WriteLine($"Nodos: {Arbol.Count}");

        cargando = false;
    }

    private Task AbrirModalSubir()
    {
        MostrarModalSubir = true;
        return Task.CompletedTask;
    }

    private Task CerrarModalSubir()
    {
        MostrarModalSubir = false;
        return Task.CompletedTask;
    }

    private async Task RecargarArbol()
    {
        MostrarModalSubir = false;

        await CargarArbol();
    }

    private Task SeleccionarDocumento(ArchivoPermanenteNodoDTO nodo)
    {
        documentUrl = null;

        /*
         * Después aquí irá:
         *
         * var bytes = await ArchivoService.DescargarArchivo(nodo.IdArchivo);
         * documentUrl = ...
         */

        return Task.CompletedTask;
    }
}