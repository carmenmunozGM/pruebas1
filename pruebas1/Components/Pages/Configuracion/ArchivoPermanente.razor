@page "/archivo-permanente"

@using System.Diagnostics
@using pruebas1.Components.DTOs
@using pruebas1.Servicios
@using Microsoft.AspNetCore.Components.Forms

@inject ArchivoPermanenteService ArchivoService
@inject IJSRuntime JS

<div class="archivo-header">
    <div class="header-info">
        <h2>Archivo Permanente</h2>
        <p>Consulta y administración documental.</p>
    </div>
</div>

<div class="acciones">

    @if (permisosAP?.Cargar == true)
    {
        <button class="btn-subir" @onclick="AbrirModalSubir">
            📤 Subir archivos
        </button>

        <button class="btn-subir" @onclick="AbrirModalCrearCarpeta">
            📁 Nueva carpeta
        </button>
    }

    <button class="btn-sincronizar"
            @onclick="ActualizarArchivoPermanente"
            disabled="@Actualizando">

        @if (Actualizando)
        {
            <span>🔄 Actualizando...</span>
        }
        else
        {
            <span>🔄 Actualizar estructura</span>
        }

    </button>

    <input class="input-busqueda"
           @bind="textoBusqueda"
           @bind:event="oninput"
           placeholder="Buscar documento..." />

</div>

<ModalSubirArchivo Visible="@MostrarModalSubir"
                   OnClose="CerrarModalSubir"
                   OnGuardado="RecargarArbol" />

<ModalCrearCarpeta Visible="@MostrarModalCrearCarpeta"
                   OnClose="CerrarModalCrearCarpeta"
                   OnCarpetaCreada="RecargarArbol" />

<ModalArchivoPermanente Visible="@MostrarModalOpciones"
                        Nodo="@NodoSeleccionado"
                        Permisos="@permisosAP"
                        OnClose="CerrarModalOpciones"
                        OnEliminado="RecargarArbol" />

<div class="archivo-layout">

    <!-- Árbol -->
    <aside class="tree-panel">

        @if (cargando)
        {
            <div class="loading">
                Cargando estructura...
            </div>
        }
        else if (!Arbol.Any())
        {
            <div class="loading">
                No existen carpetas.
            </div>
        }
        else
        {
            @foreach (var nodo in Arbol)
            {
                <ArchivoPermanenteNodo Nodo="nodo"
                                       OnArchivoSeleccionado="SeleccionarDocumento"
                                       OnAbrirOpciones="AbrirOpcionesNodo" />
            }
        }

    </aside>

    @if (permisosAP?.Visualizar == true)
    {
        <!-- Visor -->
        <section class="viewer-panel">
            @if (string.IsNullOrWhiteSpace(documentUrl))
            {
                <div class="empty-state">
                    <div class="empty-icon">📄</div>
                    <h3>Ningún documento seleccionado</h3>
                    <p>Selecciona un documento desde el árbol.</p>
                </div>
            }
            else
            {
                <iframe class="pdf-viewer" src="@documentUrl"></iframe>
            }
        </section>
    }

</div>

@code
{
    private List<ArchivoPermanenteNodoDTO> Arbol = new();
    private List<ArchivoPermanenteNodoDTO> ArbolOriginal = new();

    private string? documentUrl;

    private string _textoBusqueda = "";

    private string textoBusqueda
    {
        get => _textoBusqueda;
        set
        {
            _textoBusqueda = value;
            Buscar();
        }
    }

    private void SeleccionarCarpetaPadre(ArchivoPermanenteNodoDTO nodo)
    {
        idCarpetaPadreSeleccionada = nodo.IdSharePoint; // Guardamos el ID de SharePoint de la carpeta seleccionada
    }

    private bool cargando;
    private bool MostrarModalSubir;
    private bool MostrarModalCrearCarpeta;
    private bool MostrarModalOpciones;

    private string idCarpetaPadreSeleccionada = "root";
    private ArchivoPermanenteNodoDTO? NodoSeleccionado;

    private PermisosArchivoDTO? permisosAP;

    protected override async Task OnInitializedAsync()
    {
        // Obtener permisos antes de cargar el árbol
        permisosAP = await ArchivoService.ObtenerMisPermisos();
        await CargarArbol();
    }
    private async Task CargarArbol()
    {
        cargando = true;

        ArbolOriginal = await ArchivoService.ObtenerArbol();

        Arbol = ArbolOriginal;

        cargando = false;
    }

    private Task AbrirModalSubir()
    {
        MostrarModalSubir = true;
        return Task.CompletedTask;
    }

    private Task CerrarModalSubir()
    {
        MostrarModalSubir = false;
        return Task.CompletedTask;
    }

    private void AbrirModalCrearCarpeta()
    {
        MostrarModalCrearCarpeta = true;
    }

    private void CerrarModalCrearCarpeta()
    {
        MostrarModalCrearCarpeta = false;
    }

    private async Task RecargarArbol()
    {
        MostrarModalSubir = false;
        MostrarModalCrearCarpeta = false;

        await CargarArbol();
    }

    private async Task SeleccionarDocumento(ArchivoPermanenteNodoDTO nodo)
    {
        if (nodo.EsCarpeta)
            return;

        if (nodo.IdBD == null)
            return;

        if (!nodo.Nombre.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
        {
            documentUrl = null;

            // Reemplazo de alert por SweetAlert2 (Swal.fire)
            await JS.InvokeVoidAsync(
                "Swal.fire",
                "Atención",
                "Solo es posible visualizar archivos PDF.",
                "warning"
            );

            return;
        }

        documentUrl =
   $"{ArchivoService.UrlBase}/archivoPermanente/archivo-permanente/visualizar/{nodo.IdBD}#toolbar=0&navpanes=0&scrollbar=0";

        StateHasChanged();
    }

    private Task AbrirOpcionesNodo(ArchivoPermanenteNodoDTO nodo)
    {
        NodoSeleccionado = nodo;
        MostrarModalOpciones = true;
        return Task.CompletedTask;
    }

    private Task CerrarModalOpciones()
    {
        MostrarModalOpciones = false;
        NodoSeleccionado = null;
        return Task.CompletedTask;
    }

    private bool Actualizando;

    private async Task ActualizarArchivoPermanente()
    {
        try
        {
            Actualizando = true;
            StateHasChanged();

            bool ok = await ArchivoService.InicializarEstructura();

            if (!ok)
            {
                await JS.InvokeVoidAsync(
                    "alert",
                    "No fue posible inicializar la estructura.");
                return;
            }

            ok = await ArchivoService.SincronizarDesdeSharePoint();

            if (!ok)
            {
                await JS.InvokeVoidAsync(
                    "alert",
                    "No fue posible sincronizar la estructura.");
                return;
            }

            await RecargarArbol();

            // Reemplazo de alert por SweetAlert2 (Swal.fire)
            await JS.InvokeVoidAsync(
                "Swal.fire",
                "¡Éxito!",
                "Archivo Permanente actualizado correctamente.",
                "success"
            );
        }
        finally
        {
            Actualizando = false;
            StateHasChanged();
        }
    }

    private void Buscar()
    {
        if (string.IsNullOrWhiteSpace(textoBusqueda))
        {
            Arbol = ArbolOriginal;
            return;
        }

        Arbol = FiltrarNodos(
            ArbolOriginal,
            textoBusqueda.Trim());
    }

    private List<ArchivoPermanenteNodoDTO> FiltrarNodos(
    List<ArchivoPermanenteNodoDTO> origen,
    string texto)
    {
        var resultado = new List<ArchivoPermanenteNodoDTO>();

        foreach (var nodo in origen)
        {
            bool coincide = nodo.Nombre.Contains(
                texto,
                StringComparison.OrdinalIgnoreCase);

            if (coincide)
            {
                resultado.Add(ClonarNodoCompleto(nodo));
                continue;
            }

            var hijos = FiltrarNodos(nodo.Hijos, texto);

            if (hijos.Any())
            {
                var copia = ClonarNodo(nodo);
                copia.Hijos = hijos;

                resultado.Add(copia);
            }
        }

        return resultado;
    }

    private ArchivoPermanenteNodoDTO ClonarNodo(ArchivoPermanenteNodoDTO nodo)
    {
        return new ArchivoPermanenteNodoDTO
        {
            IdBD = nodo.IdBD,
            IdSharePoint = nodo.IdSharePoint,
            Nombre = nodo.Nombre,
            EsCarpeta = nodo.EsCarpeta,
            Hijos = new List<ArchivoPermanenteNodoDTO>()
        };
    }

    private ArchivoPermanenteNodoDTO ClonarNodoCompleto(ArchivoPermanenteNodoDTO nodo)
    {
        return new ArchivoPermanenteNodoDTO
        {
            IdBD = nodo.IdBD,
            IdSharePoint = nodo.IdSharePoint,
            Nombre = nodo.Nombre,
            EsCarpeta = nodo.EsCarpeta,
            Hijos = nodo.Hijos
                .Select(ClonarNodoCompleto)
                .ToList()
        };
    }
}