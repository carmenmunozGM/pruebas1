﻿@using pruebas1.Components.DTOs
@using Microsoft.AspNetCore.Components.Web

<div class="tree-node">

    @if (Nodo.EsCarpeta)
    {
        <div class="tree-folder"
             @onclick="Toggle"
             @oncontextmenu="AbrirOpciones"
             @oncontextmenu:preventDefault="true">

            @if (Nodo.Hijos.Any())
            {
                <span class="arrow">
                    @(Expandido ? "▼" : "▶")
                </span>
            }
            else
            {
                <span class="arrow-empty"></span>
            }

            📁 <span class="tree-text" title="@Nodo.Nombre">@Nodo.Nombre</span>

        </div>

        @if (Expandido)
        {
            <div class="tree-children">

                @foreach (var hijo in Nodo.Hijos)
                {
                    <ArchivoPermanenteNodo Nodo="hijo"
                                           OnArchivoSeleccionado="OnArchivoSeleccionado"
                                           OnAbrirOpciones="OnAbrirOpciones" />
                }

            </div>
        }
    }
    else
    {
        <div class="tree-file"
             @onclick="Seleccionar"
             @oncontextmenu="AbrirOpciones"
             @oncontextmenu:preventDefault="true">

            📄 <span class="tree-text" title="@Nodo.Nombre">@Nodo.Nombre</span>

        </div>
    }

</div>

@code {

    [Parameter]
    public ArchivoPermanenteNodoDTO Nodo { get; set; } = default!;

    [Parameter]
    public EventCallback<ArchivoPermanenteNodoDTO> OnArchivoSeleccionado { get; set; }

    [Parameter]
    public EventCallback<ArchivoPermanenteNodoDTO> OnAbrirOpciones { get; set; }

    private bool Expandido;

    void Toggle()
    {
        Expandido = !Expandido;
    }

    async Task Seleccionar()
    {
        await OnArchivoSeleccionado.InvokeAsync(Nodo);
    }

    private async Task AbrirOpciones(MouseEventArgs e)
    {
        await OnAbrirOpciones.InvokeAsync(Nodo);
    }
}