@using Microsoft.AspNetCore.Components.Forms
@using pruebas1.Components.DTOs
@using pruebas1.Servicios
@inject IJSRuntime JS
@inject ArchivoPermanenteService ArchivoService

@if (Visible)
{
    <div class="modal-subir-overlay">
        <div class="modal-subir">
            <div class="modal-header">
                <h3>📤 Subir archivos</h3>
                <button class="btn-cerrar" @onclick="Cerrar">✕</button>
            </div>

            <div class="modal-body">
                @if (Cargando)
                {
                    <div class="loading">
                        Cargando estructura...
                    </div>
                }
                else
                {
                    <h4>Ruta destino</h4>

                    @for (int i = 0; i < Niveles.Count; i++)
                    {
                        int indice = i;
                        bool esUltimoNivel = (indice == Niveles.Count - 1);
                        bool estaAbierto = DropdownAbiertoIndice == indice;
                        string textoSeleccionado = ObtenerTextoSeleccionado(indice);
                        var listaOpciones = ObtenerOpcionesFiltradas(indice);

                        <div class="custom-select-container">
                            <div class="custom-select-trigger" @onclick="() => ToggleDropdown(indice)">
                                <span>@textoSeleccionado</span>
                                <span class="arrow">▼</span>
                            </div>

                            @if (estaAbierto)
                            {
                                <div class="custom-select-menu">
                                    <div class="search-box-inside">
                                        <input type="text"
                                               class="input-search-dropdown"
                                               placeholder="🔍 Buscar..."
                                               @bind="TextoBusqueda"
                                               @bind:event="oninput"
                                               @onclick:stopPropagation />
                                    </div>
                                    <ul class="custom-select-options">
                                        <li class="@(Seleccionados.Count <= indice && !CreandoNuevaCarpeta ? "selected" : "")"
                                            @onclick='() => SeleccionarOpcion(indice, "", "Seleccione...")'>
                                            Seleccione...
                                        </li>

                                        @foreach (var item in listaOpciones)
                                        {
                                            bool esSeleccionado = Seleccionados.Count > indice && Seleccionados[indice]?.Id == item.Id && !CreandoNuevaCarpeta;
                                            <li class="@(esSeleccionado ? "selected" : "")"
                                                @onclick='() => SeleccionarOpcion(indice, item.Id.ToString(), $"{item.Codigo} - {item.Nombre}")'>
                                                @($"{item.Codigo} - {item.Nombre}")
                                            </li>
                                        }

                                        @if (MostrarCrearCarpeta && esUltimoNivel)
                                        {
                                            <li class="@(CreandoNuevaCarpeta ? "selected" : "")"
                                                @onclick='() => SeleccionarOpcion(indice, "-1", "➕ Crear nueva carpeta...")'>
                                                ➕ Crear nueva carpeta...
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    }

                    @if (CreandoNuevaCarpeta)
                    {
                        <div class="campo">
                            <label>Nombre de la carpeta</label>
                            <input class="input"
                                   @bind="NombreCarpeta"
                                   @bind:event="oninput"
                                   placeholder="Escribe el nombre..." />
                        </div>
                    }

                    @if (PuedeMostrarSelectorArchivos)
                    {
                        <div class="campo">
                            <label>
                                @(CreandoNuevaCarpeta ? "Archivos (opcional)" : "Archivos")
                            </label>
                            <InputFile multiple
                                       OnChange="ArchivosSeleccionados"
                                       class="input-file-oculto"
                                       maxAllowedSize="78643200" />
                            <div class="input-file-fake">
                                📂 Seleccionar archivos...
                            </div>
                        </div>
                    }

                    @if (Archivos.Any())
                    {
                        <div class="lista-archivos">
                            @foreach (var archivo in Archivos)
                            {
                                <div class="archivo-item">
                                    <span>📄 @archivo.Name</span>
                                    <button class="btn-eliminar" @onclick="() => QuitarArchivo(archivo)">
                                        ✕
                                    </button>
                                </div>
                            }
                        </div>
                    }
                }
            </div>

            <div class="modal-footer">
                <button class="btn-cancelar" @onclick="Cerrar">
                    Cancelar
                </button>

                <button class="btn-guardar"
                        disabled="@(!PuedeSubir || Subiendo)"
                        @onclick="Subir">
                    @if (Subiendo)
                    {
                        <span class="spinner"></span>
                        <span>Subiendo...</span>
                    }
                    else
                    {
                        <span>📤 Subir</span>
                    }
                </button>
            </div>

            @if (GuardadoCorrectamente)
            {
                <div class="mensaje-ok-flotante">
                    ✔ Archivos cargados correctamente
                </div>
            }
        </div>
    </div>
}

<style>
    .custom-select-container {
        position: relative;
        width: 100%;
        margin-bottom: 10px;
    }

    .custom-select-trigger {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 12px;
        background: #fff;
        border: 1px solid #ccc;
        border-radius: 6px;
        cursor: pointer;
        font-size: 14px;
    }

    .custom-select-menu {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 99;
        background: #fff;
        border: 1px solid #ccc;
        border-radius: 6px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.15);
        margin-top: 4px;
    }

    .search-box-inside {
        padding: 8px;
        border-bottom: 1px solid #eee;
    }

    .input-search-dropdown {
        width: 100%;
        padding: 6px 10px;
        border: 1px solid #ddd;
        border-radius: 4px;
        outline: none;
        box-sizing: border-box;
    }

    .custom-select-options {
        list-style: none;
        margin: 0;
        padding: 0;
        max-height: 180px;
        overflow-y: auto;
    }

        .custom-select-options li {
            padding: 8px 12px;
            cursor: pointer;
            font-size: 14px;
        }

            .custom-select-options li:hover {
                background-color: #f0f4f8;
            }

            .custom-select-options li.selected {
                background-color: #e2e8f0;
                font-weight: bold;
            }
</style>

@code
{
    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnGuardado { get; set; }

    private bool Cargando;
    private int? DropdownAbiertoIndice;
    private string TextoBusqueda = string.Empty;

    private List<UbicacionDTO> Ubicaciones = new();
    private List<List<UbicacionDTO>> Niveles = new();
    private List<UbicacionDTO?> Seleccionados = new();
    private List<IBrowserFile> Archivos = new();
    private string NombreCarpeta = "";
    private UbicacionDTO? CarpetaSeleccionada;
    private bool CreandoNuevaCarpeta;
    private bool MostrarCrearCarpeta;
    private bool Subiendo;
    private bool GuardadoCorrectamente;

    private bool PuedeMostrarSelectorArchivos =>
        CreandoNuevaCarpeta || (CarpetaSeleccionada?.PermiteArchivos ?? false);

    protected override async Task OnParametersSetAsync()
    {
        if (!Visible)
            return;

        if (Ubicaciones.Any())
            return;

        Cargando = true;
        Ubicaciones = await ArchivoService.ObtenerUbicaciones();

        Niveles.Clear();
        Seleccionados.Clear();
        Niveles.Add(Ubicaciones);
        Cargando = false;
    }

    private void ToggleDropdown(int indice)
    {
        if (DropdownAbiertoIndice == indice)
        {
            DropdownAbiertoIndice = null;
        }
        else
        {
            DropdownAbiertoIndice = indice;
            TextoBusqueda = string.Empty;
        }
    }

    private List<UbicacionDTO> ObtenerOpcionesFiltradas(int nivel)
    {
        var listaBase = Niveles[nivel];
        if (string.IsNullOrWhiteSpace(TextoBusqueda))
            return listaBase;

        return listaBase.Where(x =>
            (x.Nombre != null && x.Nombre.Contains(TextoBusqueda, StringComparison.OrdinalIgnoreCase)) ||
            (x.Codigo != null && x.Codigo.Contains(TextoBusqueda, StringComparison.OrdinalIgnoreCase))
        ).ToList();
    }

    private string ObtenerTextoSeleccionado(int nivel)
    {
        if (CreandoNuevaCarpeta && nivel == Niveles.Count - 1)
        {
            return "➕ Crear nueva carpeta...";
        }

        if (Seleccionados.Count > nivel && Seleccionados[nivel] != null)
        {
            var item = Seleccionados[nivel]!;
            return $"{item.Codigo} - {item.Nombre}";
        }

        return "Seleccione...";
    }

    private void SeleccionarOpcion(int nivel, string valor, string nombre)
    {
        DropdownAbiertoIndice = null;
        TextoBusqueda = string.Empty;

        SeleccionarNivel(nivel, valor);
    }

    private void SeleccionarNivel(int nivel, string? valor)
    {
        while (Niveles.Count > nivel + 1)
            Niveles.RemoveAt(nivel + 1);

        while (Seleccionados.Count > nivel)
            Seleccionados.RemoveAt(nivel);

        CreandoNuevaCarpeta = false;
        MostrarCrearCarpeta = false;

        if (string.IsNullOrWhiteSpace(valor))
        {
            CarpetaSeleccionada = null;
            return;
        }

        if (valor == "-1")
        {
            CreandoNuevaCarpeta = true;
            CarpetaSeleccionada = Seleccionados.LastOrDefault();
            return;
        }

        var seleccionado = Niveles[nivel].First(x => x.Id == int.Parse(valor));
        Seleccionados.Add(seleccionado);
        CarpetaSeleccionada = seleccionado;

        if (seleccionado.Hijos.Any())
        {
            Niveles.Add(seleccionado.Hijos);
        }

        if (seleccionado.EsDinamica)
        {
            MostrarCrearCarpeta = true;
        }
    }

    private void ArchivosSeleccionados(InputFileChangeEventArgs e)
    {
        Archivos = e.GetMultipleFiles().ToList();
        StateHasChanged();
    }

    private void QuitarArchivo(IBrowserFile archivo)
    {
        Archivos.Remove(archivo);
        StateHasChanged();
    }

    private bool PuedeSubir
    {
        get
        {
            if (CarpetaSeleccionada == null)
                return false;

            if (CreandoNuevaCarpeta)
                return !string.IsNullOrWhiteSpace(NombreCarpeta);

            if (CarpetaSeleccionada.PermiteArchivos)
                return Archivos.Any();

            return false;
        }
    }

    private async Task Subir()
    {
        if (CarpetaSeleccionada == null)
            return;

        try
        {
            Subiendo = true;

            var dto = new ArchivoPermanenteCrearDTO
            {
                IdCarpetaPadre = CarpetaSeleccionada.IdSharePoint!,
                NombreCarpeta = NombreCarpeta,
                Archivos = Archivos
            };

            await ArchivoService.SubirArchivoAsync(dto);

            GuardadoCorrectamente = true;
            StateHasChanged();

            await Task.Delay(1200);
            await Limpiar();
            await OnGuardado.InvokeAsync();
        }
        catch (IOException ex)
        {
            await JS.InvokeVoidAsync("Swal.fire", new
            {
                title = "Error al subir",
                text = $"No fue posible subir el archivo.\n\n{ex.Message}",
                icon = "error",
                confirmButtonText = "Entendido",
                confirmButtonColor = "#2d7ff9"
            });
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("Swal.fire", new
            {
                title = "Ocurrió un error",
                text = ex.Message,
                icon = "error",
                confirmButtonText = "Entendido",
                confirmButtonColor = "#2d7ff9"
            });
        }
        finally
        {
            Subiendo = false;
        }
    }

    private async Task Cerrar()
    {
        await Limpiar();
        await OnClose.InvokeAsync();
    }

    private Task Limpiar()
    {
        NombreCarpeta = "";
        Archivos.Clear();
        CarpetaSeleccionada = null;
        CreandoNuevaCarpeta = false;
        MostrarCrearCarpeta = false;
        DropdownAbiertoIndice = null;
        TextoBusqueda = string.Empty;
        GuardadoCorrectamente = false;
        Niveles.Clear();
        Seleccionados.Clear();
        Niveles.Add(Ubicaciones);
        return Task.CompletedTask;
    }
}