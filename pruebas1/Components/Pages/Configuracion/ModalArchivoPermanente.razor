@using pruebas1.Components.DTOs
@using pruebas1.Servicios

@inject ArchivoPermanenteService ArchivoService
@inject IJSRuntime JS

@if (Visible && Nodo != null)
{
    <div class="modal-archivo-overlay">

        <div class="modal-archivo">

            <div class="modal-header">

                <h3>
                    @(Nodo.EsCarpeta ? "📁" : "📄")
                    @Nodo.Nombre
                </h3>

                <button class="btn-cerrar"
                        @onclick="Cerrar">
                    ✕
                </button>

            </div>

            <div class="modal-body">

                @if (!ConfirmandoEliminar)
                {
                    <div class="tipo">
                        @(Nodo.EsCarpeta ? "Carpeta" : "Archivo")
                    </div>

                    @if (!Nodo.EsCarpeta && Permisos?.Descargar == true)
                    {
                        <button class="accion descargar" @onclick="Descargar">
                            ⬇ Descargar
                        </button>
                    }

                    @if (Permisos?.Cargar == true)
                    {
                        <button class="accion eliminar" @onclick="() => ConfirmandoEliminar = true">
                            🗑
                            @(Nodo.EsCarpeta ? "Eliminar carpeta" : "Eliminar archivo")
                        </button>
                    }
                        }
                else
                {
                    <div class="confirmacion">

                        <div class="icono-alerta">
                            ⚠️
                        </div>

                        <h3>
                            ¿Eliminar @(Nodo.EsCarpeta ? "la carpeta" : "el archivo")?
                        </h3>

                        <p>
                            <strong>@Nodo.Nombre</strong>
                        </p>

                        <span>
                            Esta acción no se puede deshacer.
                        </span>

                        <div class="confirmacion-botones">

                            <button class="btn-cancelar"
                                    @onclick="CancelarEliminar">
                                Cancelar
                            </button>

                            <button class="btn-eliminar-final"
                                    disabled="@Eliminando"
                                    @onclick="Eliminar">

                                @if (Eliminando)
                                {
                                    <span>Eliminando...</span>
                                }
                                else
                                {
                                    <span>🗑 Sí, eliminar</span>
                                }

                            </button>

                        </div>

                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Mensaje))
                {
                    <div class="mensaje @(OperacionCorrecta ? "ok" : "error")">
                        @Mensaje
                    </div>
                }

            </div>

            <div class="modal-footer">

                <button class="btn-cancelar"
                        @onclick="Cerrar">

                    Cancelar

                </button>

            </div>

        </div>

    </div>
}

@code
{
    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public PermisosArchivoDTO? Permisos { get; set; }

    [Parameter]
    public ArchivoPermanenteNodoDTO? Nodo { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnEliminado { get; set; }

    private bool ConfirmandoEliminar;

    private bool Eliminando;

    private string? Mensaje;

    private bool OperacionCorrecta;

    private async Task Descargar()
    {
        if (Nodo?.IdBD == null)
            return;

        await JS.InvokeVoidAsync(
            "open",
            ArchivoService.ObtenerUrlDescarga(Nodo.IdBD.Value),
            "_blank");

        await Cerrar();
    }

    private async Task Eliminar()
    {
        if (Nodo == null)
            return;

        Eliminando = true;

        StateHasChanged();

        bool ok;

        if (Nodo.EsCarpeta)
        {
            ok = await ArchivoService.EliminarCarpeta(Nodo.IdBD!.Value);
        }
        else
        {
            ok = await ArchivoService.EliminarArchivo(Nodo.IdBD!.Value);
        }

        Eliminando = false;

        if (!ok)
        {
            OperacionCorrecta = false;
            Mensaje = "No fue posible eliminar.";

            StateHasChanged();

            await Task.Delay(2500);

            Mensaje = null;

            return;
        }

        OperacionCorrecta = true;
        Mensaje = "Elemento eliminado correctamente.";

        StateHasChanged();

        await Task.Delay(900);

        await Cerrar();

        await OnEliminado.InvokeAsync();
    }

    private async Task Cerrar()
    {
        ConfirmandoEliminar = false;
        Eliminando = false;
        Mensaje = null;
        OperacionCorrecta = false;

        await OnClose.InvokeAsync();
    }

    private void CancelarEliminar()
    {
        ConfirmandoEliminar = false;
    }
}